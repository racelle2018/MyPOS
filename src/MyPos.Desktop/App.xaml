<Application x:Class="MyPos.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyPos.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <FontFamily x:Key="UiFontFamily">/MyPos.Desktop;component/Assets/Fonts/#Wix Madefor Text</FontFamily>
        <FontFamily x:Key="ReportInterFontFamily">/MyPos.Desktop;component/Assets/Fonts/#Inter</FontFamily>
        <!-- Shared light-theme tokens; use these before adding screen-specific colors. -->
        <SolidColorBrush x:Key="UiBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="UiSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UiTextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="UiMutedBrush" Color="#475569"/>
        <SolidColorBrush x:Key="UiBorderBrush" Color="#C7D4E2"/>
        <SolidColorBrush x:Key="UiAccentBrush" Color="#2878BD"/>
        <SolidColorBrush x:Key="UiAccentSoftBrush" Color="#EAF3FB"/>
        <SolidColorBrush x:Key="UiDangerBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="UiWarningBrush" Color="#92400E"/>
        <SolidColorBrush x:Key="UiSuccessBrush" Color="#166534"/>

        <Style x:Key="MyPosFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource UiAccentBrush}"
                                BorderThickness="2" CornerRadius="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Light, restrained surfaces inspired by the reference login UI.
             Keep the POS's dense data layout while giving controls consistent chrome. -->

        <!-- Compact, readable typography across every screen. -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
        </Style>

        <!-- Extend Material Design controls without replacing their keyboard/focus templates. -->
        <Style x:Key="MyPosButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource MyPosButton}"/>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource MyPosButton}">
            <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MyPosButton}">
            <Setter Property="Background" Value="{StaticResource UiAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Preserve existing Tag-based placeholders through Material hints. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="SelectionBrush" Value="#C6E1F7"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            <Setter Property="materialDesign:HintAssist.Hint"
                    Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Compact report picker: the arrow and date text share one measured row. -->
        <ControlTemplate x:Key="ReportDateDropDownButtonTemplate" TargetType="Button">
            <Border x:Name="Chrome" Background="#F3F5F6"
                    BorderBrush="#AEB7C0" BorderThickness="1,0,0,0"
                    SnapsToDevicePixels="True">
                <Path Width="8" Height="5" Stretch="Fill"
                      Data="M 0 0 L 8 0 L 4 5 Z" Fill="#334155"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#E6EFF6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#D8E8F3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- The stock DatePickerTextBox draws its own border and "Enter text here" watermark. -->
        <Style x:Key="ReportDateTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                            <ContentControl x:Name="PART_Watermark"
                                            Opacity="0" Focusable="False"
                                            IsHitTestVisible="False">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <TextBlock Text="/ /" TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource UiMutedBrush}"/>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Watermark" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ReportDatePickerTemplate" TargetType="DatePicker">
            <Border x:Name="PickerBorder" Background="White" BorderBrush="#AEB7C0"
                    BorderThickness="1" SnapsToDevicePixels="True">
                <Grid x:Name="PART_Root">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                       Style="{StaticResource ReportDateTextBox}"
                                       Background="Transparent" BorderThickness="0"
                                       MaxLength="10"
                                       Height="26" MinHeight="0" MinWidth="0"
                                       Padding="0" TextAlignment="Center"
                                       VerticalContentAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Focusable="{TemplateBinding Focusable}"/>
                    <Button x:Name="PART_Button" Grid.Column="1"
                            Template="{StaticResource ReportDateDropDownButtonTemplate}"
                            Height="26" MinHeight="0" MinWidth="0" Padding="0"
                            Focusable="False" IsTabStop="False"
                            AutomationProperties.Name="Open calendar"
                            ToolTip="Open calendar"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=PART_Root}"
                           StaysOpen="False" AllowsTransparency="True"/>
                    <Popup x:Name="DateWarningPopup" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=PickerBorder}"
                           VerticalOffset="2" StaysOpen="True"
                           Focusable="False" AllowsTransparency="True"
                           IsHitTestVisible="False"
                           Tag="{Binding Path=(controls:ReportDatePickerBehavior.InputErrorMessage), RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Background="#FFF8F7" BorderBrush="{StaticResource UiDangerBrush}"
                                BorderThickness="1" Padding="8,5">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Popup}}"
                                       Foreground="{StaticResource UiDangerBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="220"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="PickerBorder" Property="BorderBrush"
                            Value="{StaticResource UiAccentBrush}"/>
                </Trigger>
                <Trigger Property="controls:ReportDatePickerBehavior.HasInputError" Value="True">
                    <Setter TargetName="PickerBorder" Property="BorderBrush"
                            Value="{StaticResource UiDangerBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="controls:ReportDatePickerBehavior.HasInputError" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="DateWarningPopup" Property="IsOpen" Value="True"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PickerBorder" Property="Opacity" Value="0.55"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ReportDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="controls:ReportDatePickerBehavior.ClearSelectionOnCalendarClose" Value="True"/>
            <Setter Property="controls:ReportDatePickerBehavior.NormalizeDateInput" Value="True"/>
            <Setter Property="Template" Value="{StaticResource ReportDatePickerTemplate}"/>
        </Style>

        <!-- Report-only WinBox-inspired button chrome. POS and shell buttons stay unchanged. -->
        <Style x:Key="ReportChromeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="#F7F8F9"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E6EFF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D8E8F3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8C969F"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F4"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D8DDE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpperBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="CharacterCasing" Value="Upper"/>
        </Style>

        <!-- Login and lock stay compact windows; only their input chrome changes. -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
        </Style>

        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignDatePicker}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="BorderBrush" Value="#AEBECD"/>
        </Style>

        <!-- Dense, readable register tables. -->

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="{StaticResource UiAccentSoftBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#C6D3E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFCFE"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource UiAccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource MyPosFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E1E7ED"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="6,0,6,0" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiAccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F659F"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="{x:Static DataGrid.FocusBorderBrushKey}" Color="#2878BD"/>

        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFCFE"/>
            <Setter Property="BorderBrush" Value="#AEBECD"/>
            <Setter Property="RowStyle" Value="{StaticResource {x:Type DataGridRow}}"/>
            <Setter Property="CellStyle" Value="{StaticResource {x:Type DataGridCell}}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource {x:Type DataGridColumnHeader}}"/>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
