<Window x:Class="MyPos.Desktop.Dialogs.CashMovementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Cash Movement" Width="380" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="RECORD CASH MOVEMENT" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Movement type" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <ComboBox x:Name="TypeBox" Margin="0,0,0,10" Height="38"
                      AutomationProperties.Name="Cash movement type">
                <ComboBoxItem Content="Cash In"/>
                <ComboBoxItem Content="Cash Out"/>
            </ComboBox>
            <TextBlock Text="Amount (₱)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Classification" FontWeight="SemiBold"/>
            <ComboBox x:Name="CategoryBox" Height="32" Margin="0,5,0,5" SelectionChanged="Category_Changed"/>
            <TextBox x:Name="ExpenseCategoryBox" Height="32" Margin="0,5,0,5" Tag="Expense category (required for expenses)"/>
            <TextBox x:Name="DestinationBox" Height="32" Margin="0,5,0,5" Tag="Bank / destination"/>
            <TextBox x:Name="ReferenceBox" Height="32" Margin="0,5,0,5" Tag="Slip / reference number"/>
            <CheckBox x:Name="ApproveNowBox" Content="Approve this movement as administrator" Margin="0,5,0,5"/>
            <TextBox x:Name="AmountBox" Height="40" Tag="Amount"
                     AutomationProperties.Name="Cash movement amount"/>
            <TextBlock Text="Reason" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <TextBox x:Name="ReasonBox" Height="60" Margin="0,0,0,8" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="10,7"
                     Tag="Reason for cash movement"
                     AutomationProperties.Name="Cash movement reason"/>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Content="Cancel" IsCancel="True" Width="80" Margin="0,5,8,5"/>
                <Button Height="32" Content="Save" IsDefault="True" Width="80"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
