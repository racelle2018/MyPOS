<Window x:Class="MyPos.Desktop.Dialogs.ChangeInitialPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Administrator Password" Width="390" MinWidth="320" MinHeight="370"
        MaxHeight="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="SET YOUR ADMIN PASSWORD" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="The starter password must be replaced before using MyPos."
                       TextWrapping="Wrap" Foreground="#475569" Margin="0,6,0,16"/>
            <TextBlock Text="New password (at least 10 characters)"/>
            <PasswordBox x:Name="NewPasswordBox" Height="34" Margin="0,4,0,10"
                         AutomationProperties.Name="New administrator password"/>
            <TextBlock Text="Confirm password"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Margin="0,4,0,6"
                         AutomationProperties.Name="Confirm administrator password"/>
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="88" Height="32" IsCancel="True" Margin="0,5,8,5"/>
                <Button Content="Save Password" Width="125" Height="32" IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
