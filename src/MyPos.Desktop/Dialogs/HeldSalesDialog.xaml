<Window x:Class="MyPos.Desktop.Dialogs.HeldSalesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Sales" Height="460" Width="600" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="HELD SALES" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select a saved sale to continue it. Discard permanently removes the draft."
                       Style="{StaticResource FieldHint}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DiscardButton" Content="Discard" Width="90" Height="32"
                    Foreground="#B91C1C" Margin="0,5,10,5"
                    Click="DiscardButton_Click"/>
            <Button x:Name="RecallButton" Content="Recall" Width="100" Height="32"
                    Style="{StaticResource PrimaryButton}" Margin="0,5,10,5"
                    IsDefault="True" Click="RecallButton_Click"/>
            <Button Content="Cancel" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>

        <Grid>
        <DataGrid x:Name="HeldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" RowHeaderWidth="0"
                  SelectionChanged="HeldGrid_SelectionChanged"
                  MouseDoubleClick="HeldGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Held at" Binding="{Binding HeldAtText}" Width="120" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="55" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Total" ElementStyle="{StaticResource RightCell}" Binding="{Binding TotalText}" Width="90"/>
                <DataGridTextColumn Header="By" Binding="{Binding UserText}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyHint" Text="No held sales to recall"
                   Style="{StaticResource FieldHint}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
