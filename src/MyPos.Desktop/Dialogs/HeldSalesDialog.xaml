<Window x:Class="MyPos.Desktop.Dialogs.HeldSalesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Sales" Height="460" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="HELD SALES"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="90" Height="34" Margin="0,0,10,0"
                    Click="DiscardButton_Click"/>
            <Button Content="Recall" Width="100" Height="34" Margin="0,0,10,0"
                    IsDefault="True" Click="RecallButton_Click"/>
            <Button Content="Cancel" Width="90" Height="34" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="HeldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" RowHeaderWidth="0"
                  MouseDoubleClick="HeldGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Held at" Binding="{Binding HeldAtText}" Width="120"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="55"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="90"/>
                <DataGridTextColumn Header="By" Binding="{Binding UserText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
