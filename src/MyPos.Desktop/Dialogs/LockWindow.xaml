<Window x:Class="MyPos.Desktop.Dialogs.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Locked" Width="420" Height="360" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#0F172A" WindowStyle="None" ShowInTaskbar="False">
    <Grid>
        <Border Width="340" Padding="28" Background="White" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="34" Foreground="#0078D7" HorizontalAlignment="Center"/>
                <TextBlock Text="SESSION LOCKED" FontSize="20" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock x:Name="UserText" FontSize="13" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <PasswordBox x:Name="PasswordBox" Height="34" PasswordChanged="PasswordBox_OnPasswordChanged"
                             KeyDown="PasswordBox_OnKeyDown"/>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on" Foreground="#B45309"
                           FontSize="11" Visibility="Collapsed" Margin="0,5,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="Unlock" Height="34" Margin="0,14,0,0" Click="UnlockButton_Click"/>
                <Button Content="Switch user" Height="30" Margin="0,8,0,0"
                        Click="SwitchUserButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
