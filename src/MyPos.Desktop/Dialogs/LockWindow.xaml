<Window x:Class="MyPos.Desktop.Dialogs.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Locked" Width="450" SizeToContent="Height"
        MaxHeight="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" CornerRadius="2" BorderBrush="#CDD1D4" BorderThickness="1" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="#2878BD" HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="M" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Session locked" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="UserText" Foreground="#64748B"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,4,0,26"/>

                <TextBlock Text="Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,6,0,4"
                             AutomationProperties.Name="Password to unlock session"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             PreviewKeyDown="PasswordBox_OnPreviewKeyDown"
                             KeyDown="PasswordBox_OnKeyDown"/>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                           Foreground="#B45309" FontSize="12"
                           Visibility="Collapsed"/>

                <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                        Height="32" Margin="0,5,0,5" IsDefault="True"
                        Click="UnlockButton_Click"/>
                <Button Content="Switch user" Height="32" Margin="0,5,0,5"
                        Click="SwitchUserButton_Click"/>
                <TextBlock x:Name="PendingCartText" Foreground="#92400E"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
