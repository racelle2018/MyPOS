<Window x:Class="MyPos.Desktop.Dialogs.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Locked" Width="450" SizeToContent="Height"
        MaxHeight="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F4F7FB">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="12" Padding="32" Margin="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="#2878BD" HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="M" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Session locked" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="UserText" Foreground="#64748B"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,4,0,26"/>

                <TextBlock Text="Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,4"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             PreviewKeyDown="PasswordBox_OnPreviewKeyDown"
                             KeyDown="PasswordBox_OnKeyDown"/>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                           Foreground="#B45309" FontSize="12"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                        Height="44" Margin="0,22,0,0" IsDefault="True"
                        Click="UnlockButton_Click"/>
                <Button Content="Switch user" Height="40" Margin="0,8,0,0"
                        Click="SwitchUserButton_Click"/>
                <TextBlock x:Name="PendingCartText" Foreground="#92400E"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
