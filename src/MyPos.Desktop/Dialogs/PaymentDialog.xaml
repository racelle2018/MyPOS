<Window x:Class="MyPos.Desktop.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment" Width="380" MinWidth="320" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16">
        <TextBlock Text="Amount Due" Foreground="#475569"/>
        <TextBlock x:Name="TotalText" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16"/>
        <TextBlock x:Name="TenderedLabel" Text="Cash Tendered"/>
        <TextBox x:Name="TenderedBox" Height="36" FontSize="18" Margin="0,4,0,10"
                 Tag="Amount received"
                 AutomationProperties.Name="Amount tendered"
                 TextAlignment="Right" TextChanged="TenderedBox_TextChanged"/>
        <WrapPanel x:Name="QuickWrap" Margin="0,0,0,14">
            <Button Height="32" Content="₱20" Tag="20" Margin="0,5,6,5" Click="QuickAmount_Click"/>
            <Button Height="32" Content="₱50" Tag="50" Margin="0,5,6,5" Click="QuickAmount_Click"/>
            <Button Height="32" Content="₱100" Tag="100" Margin="0,5,6,5" Click="QuickAmount_Click"/>
            <Button Height="32" Content="₱200" Tag="200" Margin="0,5,6,5" Click="QuickAmount_Click"/>
            <Button Height="32" Content="₱500" Tag="500" Margin="0,5,6,5" Click="QuickAmount_Click"/>
            <Button Height="32" Content="₱1000" Tag="1000" Margin="0,5,6,5" Click="QuickAmount_Click"/>
        </WrapPanel>
        <StackPanel x:Name="ReferencePanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Reference / approval no. (optional)" Foreground="#475569"/>
            <TextBox x:Name="ReferenceBox" Height="34" Margin="0,4,0,0"
                     Tag="Reference number, if provided"
                     AutomationProperties.Name="Payment reference number"/>
        </StackPanel>
        <StackPanel x:Name="ChangePanel">
            <TextBlock Text="Change" Foreground="#475569"/>
            <TextBlock x:Name="ChangeText" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,16"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Height="32" Content="Cancel" IsCancel="True" Margin="0,5,8,5"/>
            <Button Height="32" Content="Confirm (Enter)" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
</Window>
