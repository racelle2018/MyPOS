<Window x:Class="MyPos.Desktop.Dialogs.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Product Description *"/>
        <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,12"/>

        <TextBlock Text="Barcode (optional — must be unique)"/>
        <TextBox x:Name="BarcodeBox" Height="28" Margin="0,4,0,12"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Category"/>
                <ComboBox x:Name="CategoryBox" Height="28" Margin="0,4,0,0"
                          IsEditable="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Unit"/>
                <ComboBox x:Name="UnitBox" Height="28" Margin="0,4,0,0"
                          IsEditable="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Cost price (₱)"/>
                <TextBox x:Name="CostBox" Height="28" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Selling price (₱) *"/>
                <TextBox x:Name="PriceBox" Height="28" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="VatExemptBox" Content="VAT-exempt item" Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="90" Height="34" Background="#0F172A"
                    Foreground="White" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
