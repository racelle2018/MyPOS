<Window x:Class="MyPos.Desktop.Dialogs.QuantityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Quantity" Width="380" MinWidth="320"
        SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="EDIT QUANTITY" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource UiTextBrush}"/>
            <TextBlock x:Name="ProductText" TextWrapping="Wrap" Margin="0,8,0,2"
                       Foreground="{StaticResource UiTextBrush}"/>
            <TextBlock x:Name="StockText" FontSize="12" Margin="0,0,0,14"
                       Foreground="{StaticResource UiMutedBrush}"/>
            <TextBlock Text="Quantity *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="QuantityBox" Height="40" TextAlignment="Right"
                     Tag="Enter quantity" AutomationProperties.Name="Sale quantity"/>
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Content="Cancel" IsCancel="True" Width="88" Margin="0,5,8,5"/>
                <Button Height="32" Content="Save quantity" IsDefault="True" Width="125"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
