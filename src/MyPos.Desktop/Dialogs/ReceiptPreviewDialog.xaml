<Window x:Class="MyPos.Desktop.Dialogs.ReceiptPreviewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Receipt Preview" Height="620" Width="440" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="16"><TextBlock x:Name="WarningText" DockPanel.Dock="Top" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/><TextBox x:Name="ReceiptText" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="PrintButton" Content="Print" Width="90" Height="34" Margin="0,0,8,0" Click="PrintButton_Click"/><Button Content="Close" Width="90" Height="34" IsCancel="True"/></StackPanel></DockPanel>
</Window>
