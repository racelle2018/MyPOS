<Window x:Class="MyPos.Desktop.Dialogs.ReportPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview — Daily Sales" Height="720" Width="1180"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="90" Height="32" Margin="0,5,8,5" IsCancel="True"/>
            <Button Content="Print" Width="110" Height="32" Style="{StaticResource PrimaryButton}"
                    Click="PrintButton_Click"/>
        </StackPanel>
        <Border BorderBrush="#CDD1D4" BorderThickness="1" CornerRadius="2"
                Background="#EEF0F1" Padding="8">
            <FlowDocumentScrollViewer x:Name="DocViewer"/>
        </Border>
    </DockPanel>
</Window>
