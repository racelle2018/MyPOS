<Window x:Class="MyPos.Desktop.Dialogs.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale Detail" Height="520" Width="560">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="SubHeaderText" Foreground="#475569" Margin="0,4,0,0"/>
            <TextBlock x:Name="VoidedText" Foreground="#DC2626" FontWeight="SemiBold" Visibility="Collapsed"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="GrossText"/>
                <TextBlock x:Name="DiscountText"/>
                <TextBlock x:Name="VatText"/>
                <TextBlock x:Name="NetText"/>
                <TextBlock x:Name="TotalText" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="ChangeText" Foreground="#475569"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60"/>
                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding LineGross, StringFormat=₱{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
