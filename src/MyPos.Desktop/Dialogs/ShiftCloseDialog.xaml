<Window x:Class="MyPos.Desktop.Dialogs.ShiftCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Shift" Width="420" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="CLOSE SHIFT — Z-READING" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Count the physical drawer cash before closing." Style="{StaticResource FieldHint}"
                       Margin="0,4,0,12"/>
            <TextBlock Text="Counted drawer cash (₱)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="CountedBox" Height="40" Tag="Counted cash in drawer"
                     AutomationProperties.Name="Counted drawer cash"
                     TextChanged="CountedBox_TextChanged"/>
            <TextBlock Text="Notes (optional)" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <TextBox x:Name="NotesBox" Height="60" Margin="0,0,0,8" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="10,7"
                     Tag="Notes about this shift (optional)"
                     AutomationProperties.Name="Shift notes"/>
            <Border Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="FloatText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CashSalesText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CashIOText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VoidText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ExpectedText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8"/>
            <TextBlock x:Name="VariancePreview" FontWeight="SemiBold" Margin="0,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Content="Cancel" IsCancel="True" Width="80" Margin="0,5,8,5"/>
                <Button Height="32" Content="Close Shift" IsDefault="True" Width="110"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
