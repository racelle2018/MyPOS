<Window x:Class="MyPos.Desktop.Dialogs.ShiftOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Shift" Width="360" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="OPEN SHIFT — X-READING" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Opening float (₱)" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <TextBox x:Name="FloatBox" Height="40" Tag="Opening cash amount"
                     AutomationProperties.Name="Opening float amount"/>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Content="Cancel" IsCancel="True" Width="80" Margin="0,5,8,5"/>
                <Button Height="32" Content="Open Shift" IsDefault="True" Width="110"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
