<Window x:Class="MyPos.Desktop.Dialogs.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User" Width="440" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="Username * (letters and numbers)"/>
            <TextBox x:Name="UsernameBox" Height="32" Margin="0,4,0,12"
                     MaxLength="24" Tag="e.g. JUAN01"/>
            <TextBlock Text="Full name *"/>
            <TextBox x:Name="FullNameBox" Height="32" Margin="0,4,0,12"
                     Tag="Shown on screen and reports"/>
            <TextBlock Text="Role"/>
            <ComboBox x:Name="RoleBox" Height="32" Margin="0,4,0,12"/>
            <CheckBox x:Name="ActiveBox" Content="Active — can log in" Margin="0,0,0,16"/>
            <TextBlock x:Name="PasswordLabel" Text="Password * (at least 6 characters)"/>
            <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,4,0,12"/>
            <TextBlock x:Name="ConfirmLabel" Text="Confirm password *"/>
            <PasswordBox x:Name="ConfirmBox" Height="32" Margin="0,4,0,12"/>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Save" Width="90" Height="34" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
