<Window x:Class="MyPos.Desktop.Dialogs.VoidSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Sale" Height="340" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="VOID SALE" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
        <TextBlock x:Name="SaleInfoText" Foreground="#475569" Margin="0,8,0,16" TextWrapping="Wrap"/>
        <TextBlock Text="Reason for voiding * (required, recorded in the audit log)"/>
        <TextBox x:Name="ReasonBox" Height="60" Margin="0,4,0,12" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <CheckBox x:Name="ConfirmBox" Content="I understand this sale will be reversed and the items returned to stock" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Void Sale" Background="#DC2626" Foreground="White" Click="VoidButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
