<Window x:Class="MyPos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPos - Log in" Width="450" MinWidth="320"
        SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F4F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="410" Margin="22" Padding="32"
                Background="White" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                  Opacity="0.12" Color="#233047"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="#2878BD" HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="M" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Welcome back" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CompanyLabel" Text="MY STORE"
                           Foreground="#64748B" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,3,0,26"/>

                <TextBlock Text="Username" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox" Height="42" Margin="0,6,0,16"
                         Tag="Enter your username" CharacterCasing="Normal"/>

                <TextBlock Text="Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,4"
                             PreviewKeyDown="PasswordBox_PreviewKeyDown"/>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                           Foreground="#B45309" FontSize="12"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Height="44" Margin="0,22,0,0" IsDefault="True"
                        Click="LoginButton_Click"/>
                <TextBlock x:Name="VersionText" Foreground="#94A3B8"
                           FontSize="11" HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
