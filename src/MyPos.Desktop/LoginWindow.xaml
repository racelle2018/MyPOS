<Window x:Class="MyPos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MyPOS" Width="350" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow" Background="White">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/MyPos.Desktop;component/Styles/LoginMaterial.xaml"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,20">
            <Border Width="72" Height="72" CornerRadius="36"
                    Background="{StaticResource UiAccentBrush}" HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Welcome back!" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Sign in to continue to" FontSize="14"
                       Foreground="{StaticResource UiMutedBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="CompanyLabel" Text="MY STORE"
                       Foreground="{StaticResource UiMutedBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,2,0,0"/>

            <TextBox x:Name="UsernameBox" Margin="0,20,0,0"
                     Style="{StaticResource LoginMaterialTextBox}"
                     materialDesign:HintAssist.Hint="Enter Username"
                     CharacterCasing="Normal"
                     AutomationProperties.Name="Username" TextChanged="UsernameBox_TextChanged_1" FontSize="14"/>

            <PasswordBox x:Name="PasswordBox" Margin="0,16,0,0"
                         Style="{StaticResource LoginMaterialPasswordBox}"
                         materialDesign:HintAssist.Hint="Enter Password"
                         AutomationProperties.Name="Password"
                         PreviewKeyDown="PasswordBox_PreviewKeyDown" FontSize="14"/>
            <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                       Foreground="{StaticResource UiWarningBrush}" FontSize="12"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
            <Button Content="Login" Style="{StaticResource LoginMaterialButton}" Height="42"
                    Margin="0,20,0,0"
                    Click="LoginButton_Click" Background="#FF2878BD" BorderThickness="{StaticResource UiBorderThickness}" IsDefault="True" BorderBrush="{x:Null}"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource UiMutedBrush}"
                       FontSize="11" HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
