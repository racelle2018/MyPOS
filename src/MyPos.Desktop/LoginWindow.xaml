<Window x:Class="MyPos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MyPos" Width="300" Height="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" Background="White"
        FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12" Foreground="{StaticResource UiTextBrush}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/MyPos.Desktop;component/Styles/LoginMaterial.xaml"/>
    </Window.Resources>

    <ScrollViewer x:Name="LoginScroller" Background="White" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18,20,18">
            <Border x:Name="LoginLogo" Width="72" Height="72" CornerRadius="36"
                    Background="{StaticResource UiAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="WelcomeLabel" Text="Welcome back!" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="CompanyLabel" Text="MY STORE"
                       Foreground="{StaticResource UiMutedBrush}" TextWrapping="Wrap"
                       FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBox x:Name="UsernameBox" Margin="0,24,0,0"
                     Style="{StaticResource LoginMaterialTextBox}"
                     materialDesign:HintAssist.Hint="Username"
                     CharacterCasing="Normal"
                     AutomationProperties.Name="Username"/>
            <Grid Width="240" HorizontalAlignment="Center" Margin="0,12,0,0">
            <PasswordBox x:Name="PasswordBox" Margin="0" Padding="12,8,40,8"
                         Style="{StaticResource LoginMaterialPasswordBox}"
                         materialDesign:HintAssist.Hint="Password"
                         AutomationProperties.Name="Password"
                         PreviewKeyDown="PasswordBox_PreviewKeyDown"/>
            <TextBox x:Name="VisiblePasswordBox" Margin="1,8,40,8" Style="{x:Null}"
                     Padding="11,0,0,0" Background="White" BorderThickness="0" FontSize="12"
                     VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                     Visibility="Collapsed" IsReadOnly="True" Focusable="False" IsTabStop="False"
                     IsHitTestVisible="False" AutomationProperties.Name="Password preview">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <Button x:Name="RevealPasswordButton" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,6,0"
                    Style="{StaticResource ReportChromeButton}" Padding="0" Background="Transparent" BorderThickness="0"
                    ToolTip="Hold to show password" AutomationProperties.Name="Hold to show password"
                    PreviewMouseLeftButtonDown="RevealPassword_MouseDown" PreviewMouseLeftButtonUp="RevealPassword_MouseUp"
                    MouseLeave="RevealPassword_End" LostMouseCapture="RevealPassword_End" LostKeyboardFocus="RevealPassword_End"
                    PreviewKeyDown="RevealPassword_KeyDown" PreviewKeyUp="RevealPassword_KeyUp">
                <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
            </Button>
            </Grid>
            <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                       Foreground="{StaticResource UiWarningBrush}" FontSize="12"
                       Margin="0,4,0,0" Height="16" Visibility="Hidden"/>
            <Button x:Name="LoginButton" Content="Login" Style="{StaticResource LoginMaterialButton}"
                    Margin="0,10" Click="LoginButton_Click" IsDefault="True" Height="40"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource UiMutedBrush}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
