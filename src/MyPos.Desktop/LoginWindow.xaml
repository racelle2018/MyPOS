<Window x:Class="MyPos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPos — Log in" Height="540" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F1F5F9">
    <Grid>
        <Border Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="36,32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.10"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="16" Background="#0F172A"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="CompanyLabel" Text="MY STORE" FontSize="16"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="MYPOS POINT OF SALE" Foreground="#94A3B8" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>
                <TextBlock Text="Username"/>
                <TextBox x:Name="UsernameBox" Height="36" Margin="0,4,0,14"
                         CharacterCasing="Normal" VerticalContentAlignment="Center"/>
                <TextBlock Text="Password"/>
                <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,4"
                             PreviewKeyDown="PasswordBox_PreviewKeyDown"/>
                <TextBlock x:Name="CapsLockHint" Text="CAPS LOCK IS ON" Foreground="#D97706"
                           FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>
                <Button Content="Log in" Height="42" Margin="0,8,0,0"
                        Background="#0F172A" Foreground="White" FontWeight="SemiBold"
                        IsDefault="True" Click="LoginButton_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" Margin="0,14,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="VersionText" Foreground="#94A3B8" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
    </Grid>
</Window>
