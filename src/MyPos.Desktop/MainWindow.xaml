<Window x:Class="MyPos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPos" Height="640" Width="1024" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E293B">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,16,6">
                    <Button Content="New Sale" Width="95" Height="32" Style="{StaticResource HeaderButton}" Margin="3,0" Click="NavPos_Click"/>
                    <Button Content="Products" Width="90" Height="32" Style="{StaticResource HeaderButton}" Margin="3,0" Click="NavProducts_Click"/>
                    <Button Content="Reports" Width="85" Height="32" Style="{StaticResource HeaderButton}" Margin="3,0" Click="NavReports_Click"/>
                    <Button x:Name="SettingsButton" Content="Settings" Width="85" Height="32" Style="{StaticResource HeaderButton}" Margin="3,0" Click="NavSettings_Click"/>
                    <Button x:Name="LogoutButton" Content="Log out" Width="85" Height="32" Style="{StaticResource HeaderButton}" Margin="10,0,0,0" Click="LogoutButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,8,0,8">
                    <TextBlock Text="MyPos" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeText" Foreground="#CBD5E1"
                               FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ScreenHost"/>
    </DockPanel>
</Window>
