<Window x:Class="MyPos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPos" Height="620" Width="960" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="16,10">
            <DockPanel>
                <Button x:Name="LogoutButton" DockPanel.Dock="Right" Content="Log out"
                        Click="LogoutButton_Click" MinWidth="80"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MyPos" Foreground="White" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="WelcomeText" Foreground="#CBD5E1"
                               Margin="16,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="Product catalog screen coming next…"
                   Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DockPanel>
</Window>