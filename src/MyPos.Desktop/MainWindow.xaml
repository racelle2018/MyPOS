<Window x:Class="MyPos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MyPos" Height="680" Width="1120" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource UiBackgroundBrush}">
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A compact activity rail keeps every screen one click away. -->
            <Border Grid.Column="0" Background="{StaticResource UiSurfaceBrush}" BorderBrush="{StaticResource UiBorderBrush}"
                BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,7">
                        <Button x:Name="LockButton" Height="44" MinWidth="0" Margin="0,3,0,0"
                            Style="{StaticResource HeaderButton}" Click="LockButton_Click"
                            ToolTip="Lock now (F12)" AutomationProperties.Name="Lock session">
                            <materialDesign:PackIcon Kind="LockOutline" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="LogoutButton" Height="44" MinWidth="0" Margin="0,3,0,0"
                            Style="{StaticResource HeaderButton}" Click="LogoutButton_Click"
                            ToolTip="Log out" AutomationProperties.Name="Log out">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="25" Height="26"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="5,8,5,0">
                        <Border Width="40" Height="40" Margin="0,0,0,12"
                            CornerRadius="20" Background="{StaticResource UiAccentBrush}">
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="NavPosButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavPos_Click"
                            ToolTip="New Sale" AutomationProperties.Name="New Sale">
                            <materialDesign:PackIcon Kind="cart" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="NavProductsButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavProducts_Click"
                            ToolTip="Products" AutomationProperties.Name="Products">
                            <materialDesign:PackIcon Kind="Package" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="NavReportsButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavReports_Click"
                            ToolTip="Reports" AutomationProperties.Name="Reports">
                            <materialDesign:PackIcon Kind="ChartBar" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="NavShiftButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavShift_Click"
                            ToolTip="Shift" AutomationProperties.Name="Shift">
                            <materialDesign:PackIcon Kind="ClockPlus" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="NavUsersButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavUsers_Click"
                            ToolTip="Users" AutomationProperties.Name="Users">
                            <materialDesign:PackIcon Kind="AccountAdd" Width="25" Height="25"/>
                        </Button>
                        <Button x:Name="SettingsButton" Height="44" MinWidth="0" Margin="0,3"
                            Style="{StaticResource HeaderButton}" Click="NavSettings_Click"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                            <materialDesign:PackIcon Kind="Settings" Width="25" Height="25"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <!-- Workbench header: same location and hierarchy on every page. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource UiAccentBrush}"
                    BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ViewTitleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                        <TextBlock x:Name="WelcomeText" Grid.Column="1" Foreground="White"
                               FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- POS keeps its own transaction messages and clock above this shell status. -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource UiAccentBrush}" Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusSectionText" Foreground="White" FontSize="11"
                               VerticalAlignment="Center" />
                        <TextBlock Text="MyPos 1.0.0" Grid.Column="1" Foreground="White"
                               FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ContentControl x:Name="ScreenHost" />
            </DockPanel>
    </Grid>
</Window>
