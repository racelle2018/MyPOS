<Window x:Class="MyPos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPos" Height="680" Width="1120" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E293B">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Margin="16,8,0,8">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#0078D7">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyPos" Foreground="White" FontWeight="Bold" FontSize="17"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeText" Foreground="#94A3B8" FontSize="12"
                               Margin="14,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,6,12,6" VerticalAlignment="Center">
                    <Button x:Name="NavPosButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavPos_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="New Sale" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavProductsButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavProducts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Products" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReportsButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavReports_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavShiftButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavShift_Click">
                        <TextBlock Text="Shift" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="NavUsersButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavUsers_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                            <TextBlock Text="Users" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Height="34" Padding="14,0" Margin="3,0"
                            Style="{StaticResource HeaderButton}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LockButton" Height="34" MinWidth="0" Padding="12,0" Margin="6,0,0,0"
                            Style="{StaticResource HeaderButton}" Click="LockButton_Click" ToolTip="Lock now (F12)">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button x:Name="LogoutButton" Content="Log out" Height="34" Padding="14,0"
                            Margin="10,0,0,0" Style="{StaticResource HeaderButton}" Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl x:Name="ScreenHost"/>
    </DockPanel>
</Window>
