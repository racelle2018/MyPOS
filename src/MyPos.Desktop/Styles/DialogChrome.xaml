<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Merged only by dialogs; the main screens retain their own styles. -->
    <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#EEF0F1"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
    </Style>
    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="CharacterCasing" Value="Normal"/>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource UiDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiDangerBrush}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="26"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#EEF0F1"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>
</ResourceDictionary>
