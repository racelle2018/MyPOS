<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Login-specific adjustments on top of the app-wide Material theme. -->

    <!-- SmartHint uses this theme brush behind its floating label, not TextBox.Background. -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="White"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="LoginMaterialTextBox" TargetType="TextBox"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="materialDesign:HintAssist.Background" Value="White"/>
    </Style>
    <Style x:Key="LoginMaterialPasswordBox" TargetType="PasswordBox"
           BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
        <Setter Property="BorderBrush" Value="#CDD1D4"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="materialDesign:HintAssist.Background" Value="White"/>
    </Style>
    <Style x:Key="LoginMaterialButton" TargetType="Button"
           BasedOn="{StaticResource ReportChromeButton}">
        <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource UiAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2268A4"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D588B"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
