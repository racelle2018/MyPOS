<UserControl x:Class="MyPos.Desktop.Views.AppearanceSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="{StaticResource UiBorderThickness}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12">
    <Border Style="{StaticResource SettingsSection}">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Appearance" Style="{StaticResource SettingsSectionHeading}"/>
      <StackPanel Margin="12,10" MaxWidth="650" HorizontalAlignment="Left">
       <TextBlock Text="Font" FontWeight="SemiBold"/>
       <ComboBox x:Name="FontBox" MinWidth="250" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="UI font"/>
       <TextBlock Text="Text size" FontWeight="SemiBold"/>
       <ComboBox x:Name="SizeBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Text size preset"/>
       <TextBlock Text="Table spacing" FontWeight="SemiBold"/>
       <ComboBox x:Name="SpacingBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Table spacing preset"/>
       <WrapPanel>
        <Button x:Name="PreviewButton" Content="Preview" Style="{StaticResource SettingsButton}" Click="Preview_Click"/>
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource SettingsSaveButton}" Click="Save_Click" Margin="0,5,5,5"/>
        <Button x:Name="ResetButton" Content="Reset to Default" Style="{StaticResource SettingsButton}" Click="Reset_Click"/>
       </WrapPanel>
       <TextBlock Text="Save to apply. Output uses the selected font; thermal printing is unchanged." Style="{StaticResource SettingsHelp}"/>
       <TextBlock x:Name="SavedFeedbackText" Style="{StaticResource SettingsHelp}"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border x:Name="PreviewPanel" Background="White" BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="{StaticResource UiBorderThickness}" Padding="12">
     <StackPanel TextElement.FontFamily="{DynamicResource ReportInterFontFamily}" TextElement.FontSize="{DynamicResource UiFontSize12}">
      <TextBlock Text="Appearance preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="PreviewSummaryText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource UiMutedBrush}"/>
      <TextBox x:Name="SampleInput" Text="Search product or invoice" Height="{DynamicResource UiControlHeight32}" FontSize="{DynamicResource UiFontSize12}" Margin="0,0,0,6"/>
      <Button Content="Sample action" Style="{StaticResource ReportChromeButton}" Height="{DynamicResource UiControlHeight28}" HorizontalAlignment="Left"/>
      <DataGrid x:Name="SampleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
       RowHeight="{DynamicResource UiTableRowHeight28}" ColumnHeaderHeight="{DynamicResource UiTableHeaderHeight26}" FontSize="{DynamicResource UiFontSize12}" Margin="0,6,0,0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*" MinWidth="200"/>
        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="140" ElementStyle="{StaticResource RightCell}"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
