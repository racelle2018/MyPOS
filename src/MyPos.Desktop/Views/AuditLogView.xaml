<UserControl x:Class="MyPos.Desktop.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             FontFamily="{StaticResource ReportInterFontFamily}">
    <UserControl.Resources>
        <Style x:Key="AuditActionButton" TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="AuditFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AuditColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="178"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#EEF0F1"
                BorderBrush="#CDD1D4" BorderThickness="0,0,0,1"
                Padding="6,3">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="From" Style="{StaticResource AuditFilterLabel}"
                               Margin="2,0,5,2"/>
                    <DatePicker x:Name="FromPick" Width="142" Height="28" MinHeight="0"
                                Style="{StaticResource ReportDatePicker}"
                                Margin="0,0,9,2" ToolTip="Start date, inclusive"
                                SelectedDateChanged="FromPick_SelectedDateChanged"/>
                    <TextBlock Text="To" Style="{StaticResource AuditFilterLabel}"
                               Margin="0,0,5,2"/>
                    <DatePicker x:Name="ToPick" Width="142" Height="28" MinHeight="0"
                                Style="{StaticResource ReportDatePicker}"
                                Margin="0,0,12,2" ToolTip="End date, inclusive"
                                SelectedDateChanged="ToPick_SelectedDateChanged"/>
                    <TextBlock Text="Action" Style="{StaticResource AuditFilterLabel}"
                               Margin="0,0,5,2"/>
                    <ComboBox x:Name="ActionCombo" Width="160" Height="28"
                              FontFamily="{StaticResource ReportInterFontFamily}"
                              Margin="0,0,9,2" SelectionChanged="FilterCombo_SelectionChanged"/>
                    <TextBlock Text="User" Style="{StaticResource AuditFilterLabel}"
                               Margin="0,0,5,2"/>
                    <ComboBox x:Name="UserCombo" Width="130" Height="28"
                              FontFamily="{StaticResource ReportInterFontFamily}"
                              Margin="0,0,9,2" SelectionChanged="FilterCombo_SelectionChanged"/>
                    <TextBox x:Name="SearchBox" Width="170" Height="32"
                             FontFamily="{StaticResource ReportInterFontFamily}"
                             Margin="0,0,0,2" Tag="Search details"
                             TextChanged="SearchBox_TextChanged"/>
                </WrapPanel>
                <TextBlock x:Name="RangeErrorText" FontSize="12"
                           Foreground="{StaticResource UiDangerBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Background="White">
            <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      FontFamily="{StaticResource ReportInterFontFamily}"
                      behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      BorderThickness="0" Background="White"
                      RowHeight="28" ColumnHeaderHeight="26"
                      ColumnHeaderStyle="{StaticResource AuditColumnHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DateText}"
                                        Width="150" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserText}"
                                        Width="110" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTemplateColumn Header="Action" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                            <Setter Property="Foreground" Value="{Binding ActionBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Entity" Binding="{Binding Entity}"
                                        Width="90" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}"
                                        Width="*" ElementStyle="{StaticResource GridCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No audit entries match these filters"
                       Foreground="{StaticResource UiMutedBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Background="#EEF0F1"
                BorderBrush="#CDD1D4" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="CountText" Text="0 entries" FontSize="11"
                       Foreground="{StaticResource UiMutedBrush}"/>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="1,0,0,0">
            <StackPanel Margin="10,8">
                <TextBlock Text="Actions" FontWeight="SemiBold" FontSize="12"
                           Margin="2,0,0,5"/>
                <Button Content="Refresh" Style="{StaticResource AuditActionButton}"
                        Click="RefreshButton_Click"/>
                <Button Content="Today" Style="{StaticResource AuditActionButton}"
                        Click="TodayButton_Click"/>
                <Button Content="Last 7 days" Style="{StaticResource AuditActionButton}"
                        Click="WeekButton_Click"/>
                <Button Content="Last 30 days" Style="{StaticResource AuditActionButton}"
                        Click="MonthButton_Click"/>
                <Button Content="All dates" Style="{StaticResource AuditActionButton}"
                        Click="AllButton_Click"/>
                <Border BorderBrush="#CDD1D4" BorderThickness="0,1,0,0"
                        Margin="0,8,0,5"/>
                <Button Content="Export CSV" Style="{StaticResource AuditActionButton}"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
