<UserControl x:Class="MyPos.Desktop.Views.CashCountingSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}" Foreground="{StaticResource UiTextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12">
    <Border Style="{StaticResource SettingsSection}">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Cash counting settings" Style="{StaticResource SettingsSectionHeading}"/>
      <StackPanel Margin="12,10" MaxWidth="600" HorizontalAlignment="Left">
       <TextBlock Text="Minimum bill / coin denomination" FontWeight="SemiBold"/>
       <ComboBox x:Name="MinimumBox" DisplayMemberPath="Label" SelectedValuePath="Value" MinWidth="250"
        AutomationProperties.Name="Minimum counting denomination" SelectionChanged="Minimum_Changed"/>
       <TextBlock Text="Only this denomination and higher are shown when counting bills / coins. Default: ₱0.25."
        Style="{StaticResource SettingsHelp}"/>
       <TextBlock Text="Applies to new counting forms. Existing saved counts remain unchanged. Sale prices, change, VAT and manual counted totals are not rounded to this minimum."
        Style="{StaticResource SettingsHelp}"/>
       <TextBlock x:Name="AvailableText" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <Button x:Name="SaveButton" Content="Save" Style="{StaticResource SettingsSaveButton}" HorizontalAlignment="Left" Click="Save_Click"/>
       <TextBlock x:Name="SavedFeedbackText" Style="{StaticResource SettingsHelp}" Margin="0,4,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
