<UserControl x:Class="MyPos.Desktop.Views.CashMovementsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}">
 <UserControl.Resources>
  <Style x:Key="MovementHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="#EEF0F1"/>
   <Setter Property="BorderBrush" Value="#CDD1D4"/>
   <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
   <Setter Property="Padding" Value="6,3"/>
  </Style>
 </UserControl.Resources>
 <Border Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderBottomThickness}">
    <WrapPanel Margin="8,0">
     <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <DatePicker x:Name="FromPick" Width="142" Height="{DynamicResource UiControlHeight28}" Style="{StaticResource ReportDatePicker}" Margin="0,5,8,5" SelectedDateChanged="Filter_Changed"/>
     <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <DatePicker x:Name="ToPick" Width="142" Height="{DynamicResource UiControlHeight28}" Style="{StaticResource ReportDatePicker}" Margin="0,5,8,5" SelectedDateChanged="Filter_Changed"/>
     <ComboBox x:Name="TypeBox" Width="145" Height="{DynamicResource UiControlHeight28}" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Movement type">
      <ComboBoxItem Content="All movements"/><ComboBoxItem Content="Cash in"/><ComboBoxItem Content="Cash out"/>
     </ComboBox>
     <Button Content="Today" Style="{StaticResource ReportChromeButton}" Margin="0,5,6,5" Click="Today_Click"/>
     <Button Content="Last 7 days" Style="{StaticResource ReportChromeButton}" Margin="0,5,6,5" Click="Week_Click"/>
     <Button Content="Refresh" Style="{StaticResource ReportChromeButton}" Margin="0,5,6,5" Click="Refresh_Click"/>
     <Button x:Name="PrintButton" Content="Print / PDF" Style="{StaticResource ReportChromeButton}" Margin="0,5,6,5" Click="Print_Click"/>
     <Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource ReportChromeButton}" Margin="0,5,0,5" Click="Export_Click"/>
     <Button x:Name="ApproveButton" Content="Approve selected" Style="{StaticResource ReportChromeButton}" Margin="6,5,0,5" Click="Approve_Click"/>
     <ComboBox x:Name="CategoryFilterBox" Width="160" Height="{DynamicResource UiControlHeight28}" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Classification filter"/>
     <TextBox x:Name="SearchBox" Width="225" Height="{DynamicResource UiControlHeight28}" MinHeight="0" Margin="0,5,0,5" FontSize="{DynamicResource UiFontSize12}" Tag="Search reason, reference, destination" TextChanged="Search_Changed"/>
    </WrapPanel>
   </Border>
   <Border Grid.Row="1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderBottomThickness}">
    <WrapPanel Margin="8,8">
     <TextBlock Text="Cash in" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,6,0"/>
     <TextBlock x:Name="CashInText" FontWeight="SemiBold" Margin="0,0,24,0"/>
     <TextBlock Text="Cash out" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,6,0"/>
     <TextBlock x:Name="CashOutText" FontWeight="SemiBold" Margin="0,0,24,0"/>
     <TextBlock Text="Net movement" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,6,0"/>
     <TextBlock x:Name="NetText" FontWeight="SemiBold"/>
    </WrapPanel>
   </Border>
   <Grid Grid.Row="2">
    <DataGrid x:Name="MovementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="{DynamicResource UiTableRowHeight28}" ColumnHeaderHeight="{DynamicResource UiTableHeaderHeight26}"
      ColumnHeaderStyle="{StaticResource MovementHeader}" HorizontalScrollBarVisibility="Auto" SizeChanged="MovementsGrid_SizeChanged">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Date / time" Binding="{Binding Date, StringFormat=MM/dd/yyyy HH:mm:ss}" Width="155"/>
      <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="80"/>
      <DataGridTextColumn Header="Classification" Binding="{Binding Category}" Width="120"/>
      <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="140"/>
      <DataGridTextColumn Header="User" Binding="{Binding User}" Width="125"/>
      <DataGridTextColumn Header="Shift opened" Binding="{Binding ShiftOpenedAt, StringFormat=MM/dd/yyyy HH:mm}" Width="140"/>
      <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
      <DataGridTextColumn Header="Destination / reference" Binding="{Binding DestinationReference}" Width="170"/>
      <DataGridTextColumn Header="Approval" Binding="{Binding Approval}" Width="180"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
     Margin="20" Foreground="{StaticResource UiMutedBrush}" IsHitTestVisible="False"/>
   </Grid>
   <Border Grid.Row="3" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}">
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="8,5" Foreground="{StaticResource UiMutedBrush}"/>
   </Border>
  </Grid>
 </Border>
</UserControl>
