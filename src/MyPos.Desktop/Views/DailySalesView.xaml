<UserControl x:Class="MyPos.Desktop.Views.DailySalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="‹" Width="32" Click="PrevDayButton_Click"/>
                <DatePicker x:Name="DatePick" Width="150" Height="32"
                            SelectedDateFormat="Short"
                            SelectedDateChanged="DatePick_SelectedDateChanged"/>
                <Button Content="›" Width="32" Margin="4,0,12,0" Click="NextDayButton_Click"/>
                <Button Content="Today" Width="80" Click="TodayButton_Click"/>
                <Button x:Name="PrintButton" Content="Print" Width="80" Height="32"
                        Margin="16,0,0,0" Click="PrintButton_Click"/>
                <Button x:Name="ExportButton" Content="Export CSV" Width="100" Height="32"
                        Margin="8,0,0,0" Click="ExportButton_Click"/>
                <Button Content="Void Sale" Width="95" Margin="16,0,0,0"
                        Background="#DC2626" Foreground="White" Click="VoidButton_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,0,10">
            <Border Background="#0F172A" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="TOTAL SALES" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="TotalSalesText" Foreground="White" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="NET SALES" Foreground="#64748B" FontSize="10"/><TextBlock x:Name="NetSalesText" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="VAT" Foreground="#64748B" FontSize="10"/><TextBlock x:Name="VatText" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="TRANSACTIONS" Foreground="#64748B" FontSize="10"/><TextBlock x:Name="CountText" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <StackPanel><TextBlock Text="AVG. SALE" Foreground="#64748B" FontSize="10"/><TextBlock x:Name="AvgText" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#F59E0B"
                BorderThickness="1" Padding="14,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RECEIPTS:" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,14,0"/>
                <TextBlock x:Name="SystemReceiptsText" Margin="0,0,18,0"/>
                <TextBlock x:Name="ManualReceiptsText" Margin="0,0,18,0"/>
                <TextBlock x:Name="MissingReceiptsText" Margin="0,0,18,0"/>
                <TextBlock x:Name="VoidsText"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                  MouseDoubleClick="SalesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}" Width="60"/>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                <DataGridTextColumn Header="Invoice / OR No." Binding="{Binding ReceiptNumber}" Width="120"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150"/>
                <DataGridTextColumn Header="Pay Mode" Binding="{Binding PayModeText}" Width="80"/>
                <DataGridTextColumn Header="Gross" Binding="{Binding GrossAmount, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=₱{0:N2}}" Width="85"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding VatAmount, StringFormat=₱{0:N2}}" Width="80"/>
                <DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Voided" Binding="{Binding VoidedText}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
