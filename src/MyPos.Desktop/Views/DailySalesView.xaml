<UserControl x:Class="MyPos.Desktop.Views.DailySalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:converters="clr-namespace:MyPos.Desktop.Converters">
    <UserControl.Resources><converters:UpperTextConverter x:Key="UpperText"/></UserControl.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="VoidButton" Content="Void Sale" Width="90" Height="32"
                                Margin="4,0,0,0" Background="#DC2626" Foreground="White"
                                BorderBrush="#DC2626" FontWeight="SemiBold" Click="VoidButton_Click"/>
                        <Button x:Name="ExportButton" Content="Export CSV" Width="100" Height="32"
                                Margin="12,0,0,0" Click="ExportButton_Click"/>
                        <Button x:Name="PrintButton" Content="Print" Width="80" Height="32"
                                Margin="4,0,0,0" Background="#2878BD" Foreground="White"
                                FontWeight="SemiBold" Click="PrintButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevDayButton" Content="‹" Width="36" Height="34"
                                FontSize="16" Margin="0,0,4,0" Click="PrevDayButton_Click"
                                ToolTip="Previous day"/>
                        <DatePicker x:Name="DatePick" Width="150" Height="34"
                                    ToolTip="Choose the sales date"
                                    SelectedDateChanged="DatePick_SelectedDateChanged"/>
                        <Button x:Name="NextDayButton" Content="›" Width="36" Height="34"
                                FontSize="16" Margin="4,0,0,0" Click="NextDayButton_Click"
                                ToolTip="Next day"/>
                        <Button x:Name="TodayButton" Content="Today" Width="70" Height="34"
                                Margin="10,0,0,0" Click="TodayButton_Click"/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid Columns="6" Margin="0,14,0,0">
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,2"><StackPanel><TextBlock Text="TOTAL SALES" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="TotalSalesText" Text="₱0.00" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,2"><StackPanel><TextBlock Text="NET SALES" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="NetSalesText" Text="₱0.00" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,2"><StackPanel><TextBlock Text="VAT" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="VatText" Text="₱0.00" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,2"><StackPanel><TextBlock Text="TRANSACTIONS" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="CountText" Text="0" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,2"><StackPanel><TextBlock Text="AVG. SALE" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="AvgText" Text="₱0.00" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                    <Border Padding="10,2"><StackPanel><TextBlock Text="VOIDS" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="VoidsText" Text="0" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                </UniformGrid>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                        Padding="10,6" Margin="-16,10,-16,-12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RECEIPTS —" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                        <TextBlock Text="System:" Foreground="#64748B"/><TextBlock x:Name="SystemReceiptsText" Margin="4,0,16,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Manual OR:" Foreground="#64748B"/><TextBlock x:Name="ManualReceiptsText" Margin="4,0,16,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Missing:" Foreground="#64748B"/><TextBlock x:Name="MissingReceiptsText" Margin="4,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MissingHint" Text=" — INVESTIGATE: SALES WITHOUT RECEIPTS" Foreground="#DC2626" FontWeight="SemiBold" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Grid>
            <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                      CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      RowHeaderWidth="0" BorderThickness="1" BorderBrush="#E2E8F0"
                      Background="White" MouseDoubleClick="SalesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}" Width="60"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                    <DataGridTextColumn Header="Invoice / OR No." Binding="{Binding ReceiptNumber}" Width="120"/>
                    <DataGridTextColumn Header="Customer" Width="150"><DataGridTextColumn.Binding><Binding Path="CustomerName" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding></DataGridTextColumn>
                    <DataGridTextColumn Header="Pay Mode" Binding="{Binding PayModeText}" Width="80"/>
                    <DataGridTextColumn Header="Gross" ElementStyle="{StaticResource RightCell}" Binding="{Binding GrossAmount, StringFormat=₱{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Discount" ElementStyle="{StaticResource RightCell}" Binding="{Binding DiscountAmount, StringFormat=₱{0:N2}}" Width="85"/>
                    <DataGridTextColumn Header="Total" ElementStyle="{StaticResource RightCell}" Binding="{Binding TotalAmount, StringFormat=₱{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="VAT" ElementStyle="{StaticResource RightCell}" Binding="{Binding VatAmount, StringFormat=₱{0:N2}}" Width="80"/>
                    <DataGridTextColumn Header="Net" ElementStyle="{StaticResource RightCell}" Binding="{Binding NetAmount, StringFormat=₱{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Voided" Binding="{Binding VoidedText}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ReportEmptyHint" Text="No sales recorded for this date"
                       Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
