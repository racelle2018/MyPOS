<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="MyPos.Desktop.Views.DailySalesView"
             d:DesignWidth="1274.55">
    <UserControl.Resources>
        <Style x:Key="ReportToolbarButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="ReportActionButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="ReportMetricLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
        </Style>
        <Style x:Key="ReportMetricValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ReportMetricCell" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="ReportColumnHeader" TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>

    <UserControl.FontFamily>
        <StaticResource ResourceKey="ReportInterFontFamily"/>
    </UserControl.FontFamily>

    <!-- Daily totals stay above the table; reconciliation and actions share its header. -->
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="{StaticResource UiBorderBottomThickness}" Padding="6,3">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sales date" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                <Button x:Name="PrevDayButton" Grid.Column="1"
                        Content="‹" Width="28" FontSize="17"
                        Style="{StaticResource ReportToolbarButton}"
                        Margin="0,5,3,5" ToolTip="Previous day"
                        Click="PrevDayButton_Click"/>
                <DatePicker x:Name="DatePick" Grid.Column="2"
                            Height="28" Margin="0,5,0,5"
                            Style="{StaticResource ReportDatePicker}"
                            behaviors:ReportDatePickerBehavior.IsRequiredDate="True"
                            ToolTip="Choose today or an earlier date"
                            SelectedDateChanged="DatePick_SelectedDateChanged"/>
                <Button x:Name="NextDayButton" Grid.Column="3"
                        Content="›" Width="28" FontSize="17"
                        Style="{StaticResource ReportToolbarButton}"
                        Margin="3,5,8,5" ToolTip="Next day, up to today"
                        Click="NextDayButton_Click"/>
                <Button x:Name="TodayButton" Grid.Column="4"
                        Content="Today" Width="54"
                        Style="{StaticResource ReportToolbarButton}"
                        Click="TodayButton_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="5">
            <Border Style="{StaticResource ReportMetricCell}">
                <StackPanel>
                    <TextBlock Text="TOTAL SALES" Style="{StaticResource ReportMetricLabel}"/>
                    <TextBlock x:Name="TotalSalesText" Text="₱0.00" FontSize="22"
                               FontWeight="Bold" Foreground="{StaticResource UiAccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ReportMetricCell}">
                <StackPanel>
                    <TextBlock Text="NET SALES" Style="{StaticResource ReportMetricLabel}"/>
                    <TextBlock x:Name="NetSalesText" Text="₱0.00"
                               Style="{StaticResource ReportMetricValue}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ReportMetricCell}">
                <StackPanel>
                    <TextBlock Text="VAT" Style="{StaticResource ReportMetricLabel}"/>
                    <TextBlock x:Name="VatText" Text="₱0.00"
                               Style="{StaticResource ReportMetricValue}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ReportMetricCell}">
                <StackPanel>
                    <TextBlock Text="TRANSACTIONS" Style="{StaticResource ReportMetricLabel}"/>
                    <TextBlock x:Name="CountText" Text="0"
                               Style="{StaticResource ReportMetricValue}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ReportMetricCell}" BorderThickness="{StaticResource UiBorderBottomThickness}">
                <StackPanel>
                    <TextBlock Text="AVG. SALE" Style="{StaticResource ReportMetricLabel}"/>
                    <TextBlock x:Name="AvgText" Text="₱0.00"
                               Style="{StaticResource ReportMetricValue}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" FontSize="18"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="SalesPanel" Grid.Row="2" Background="White"
                BorderBrush="#AEB7C0" BorderThickness="{StaticResource UiBorderThickness}">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="SalesHeader" Grid.Row="0" Background="#EEF0F1"
                  SizeChanged="SalesHeader_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReconciliationPanel" Grid.Row="0" Grid.Column="0"
                            Margin="8,3,10,3" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="RECONCILIATION" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Width="100"><Run Text="System"/><Run Text=" In"/><Run Text="voice"/><Run Language="en-ph" Text=":"/></TextBlock>
                            <TextBlock x:Name="SystemReceiptsText" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Width="100"><Run Text="Manual "/><Run Text="Invoice"/><Run Language="en-ph" Text=":"/></TextBlock>
                            <TextBlock x:Name="ManualReceiptsText" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Width="58"><Run Text="Missing"/><Run Language="en-ph" Text=":"/></TextBlock>
                            <TextBlock x:Name="MissingReceiptsText" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Width="47"><Run Text="Voids"/><Run Language="en-ph" Text=":"/></TextBlock>
                            <TextBlock x:Name="VoidsText" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MissingHint" Text=" — Investigate sales without receipts"
                                       Foreground="{StaticResource UiDangerBrush}"
                                       Visibility="Collapsed"/>
                        </WrapPanel>
                    </Border>
                    <WrapPanel x:Name="SalesActions" Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,3,8,3">
                        <Button Content="Refresh" Style="{StaticResource ReportActionButton}"
                            Margin="0,5,5,5" Click="RefreshButton_Click"/>
                        <Button x:Name="ReprintReceiptButton" Content="Reprint Receipt"
                            Style="{StaticResource ReportActionButton}" IsEnabled="False"
                            Margin="0,5,5,5"
                            ToolTip="Select a non-voided sale with a system receipt"
                            ToolTipService.ShowOnDisabled="True"
                            Click="ReprintReceiptButton_Click"/>
                        <Button x:Name="VoidButton" Content="Void Sale"
                            Style="{StaticResource ReportActionButton}"
                            Foreground="{StaticResource UiDangerBrush}" Margin="0,5,5,5"
                            Click="VoidButton_Click"/>
                        <Button x:Name="ExportButton" Content="Export CSV"
                            Style="{StaticResource ReportActionButton}" Margin="0,5,5,5"
                            Click="ExportButton_Click"/>
                        <Button x:Name="PrintButton" Content="Print Report"
                            Style="{StaticResource ReportActionButton}"
                            Click="PrintButton_Click"/>
                    </WrapPanel>
                </Grid>
                <Border x:Name="SalesHeaderDivider" Grid.Row="0" BorderBrush="#AEB7C0"
                    BorderThickness="{StaticResource UiBorderBottomThickness}" IsHitTestVisible="False"/>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          FontFamily="{StaticResource ReportInterFontFamily}"
                          behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          BorderThickness="0" Background="White"
                          RowHeight="28" ColumnHeaderHeight="26"
                          ColumnHeaderStyle="{StaticResource ReportColumnHeader}"
                          MouseDoubleClick="SalesGrid_MouseDoubleClick"
                          SelectionChanged="SalesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}"
                                            Width="65" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}"
                                            Width="95" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="Invoice / OR" Binding="{Binding ReceiptNumber}"
                                            Width="*" MinWidth="125"
                                            ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="Customer" Width="2*" MinWidth="170"
                                            ElementStyle="{StaticResource GridCellText}" Binding="{Binding CustomerName}"/>
                            <DataGridTextColumn Header="Pay Mode" Binding="{Binding PayModeText}"
                                            Width="*" MinWidth="90"
                                            ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="Gross" Width="SizeToCells" MinWidth="95"
                                            ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding GrossAmount, StringFormat=₱\{0:N2\}}"/>
                            <DataGridTextColumn Header="Discount" Width="SizeToCells" MinWidth="85"
                                            ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding DiscountAmount, StringFormat=₱\{0:N2\}}"/>
                            <DataGridTextColumn Header="Total" Width="SizeToCells" MinWidth="95"
                                            ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding TotalAmount, StringFormat=₱\{0:N2\}}"/>
                            <DataGridTextColumn Header="VAT" Width="SizeToCells" MinWidth="85"
                                            ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding VatAmount, StringFormat=₱\{0:N2\}}"/>
                            <DataGridTextColumn Header="Net" Width="SizeToCells" MinWidth="90"
                                            ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding NetAmount, StringFormat=₱\{0:N2\}}"/>
                            <DataGridTextColumn Header="Void" Binding="{Binding VoidedText}"
                                            Width="60" ElementStyle="{StaticResource GridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ReportEmptyHint" Text="No sales recorded for this date"
                           Foreground="{StaticResource UiMutedBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="{StaticResource UiBorderTopThickness}" Padding="8,3">
            <TextBlock x:Name="TableStatusText" Text="0 sales" FontSize="11"
                       Foreground="{StaticResource UiMutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
