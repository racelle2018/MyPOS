<UserControl x:Class="MyPos.Desktop.Views.ExpandedReportsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12">
 <UserControl.Resources>
  <Style x:Key="ExpandedActionButton" TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
   <Setter Property="Height" Value="28"/>
  </Style>
  <Style x:Key="ReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="#EEF0F1"/><Setter Property="BorderBrush" Value="#CDD1D4"/>
   <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
  </Style>
 </UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderBottomThickness}">
    <StackPanel Margin="8,0">
     <WrapPanel>
      <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <DatePicker x:Name="FromPick" Width="142" Height="28" Margin="0,5,8,5" Style="{StaticResource ReportDatePicker}" SelectedDateChanged="Filter_Changed"/>
      <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <DatePicker x:Name="ToPick" Width="142" Height="28" Margin="0,5,8,5" Style="{StaticResource ReportDatePicker}" SelectedDateChanged="Filter_Changed"/>
      <ComboBox x:Name="BranchBox" DisplayMemberPath="Label" Width="155" Height="28" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Branch"/>
      <ComboBox x:Name="CashierBox" DisplayMemberPath="Label" Width="155" Height="28" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Cashier"/>
      <ComboBox x:Name="PaymentBox" DisplayMemberPath="Label" Width="140" Height="28" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Payment"/>
      <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" Width="190" Height="28" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="Historical category"/>
      <ComboBox x:Name="ModeBox" Width="160" Height="28" Margin="0,5,8,5" SelectionChanged="Filter_Changed" AutomationProperties.Name="View mode"/>
      <TextBox x:Name="SearchBox" Width="230" Height="28" MinHeight="0" Margin="0,5,0,5" FontSize="12" Tag="Search invoice or customer" TextChanged="Search_Changed"/>
     </WrapPanel>
     <WrapPanel>
      <Button Content="Today" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="Today_Click"/>
      <Button Content="Last 7 days" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="Week_Click"/>
      <Button Content="Last 30 days" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="Month_Click"/>
      <Button Content="This month" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="ThisMonth_Click"/>
      <Button Content="Refresh" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="Refresh_Click"/>
      <Button x:Name="PrintButton" Content="Print / PDF" Style="{StaticResource ExpandedActionButton}" Margin="0,5,6,5" Click="Print_Click"/>
      <Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource ExpandedActionButton}" Margin="0,5,0,5" Click="Export_Click"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="1" Margin="8,8">
    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock x:Name="ReportWarningText" TextWrapping="Wrap" FontWeight="SemiBold"
               Foreground="{StaticResource UiWarningBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <DataGrid x:Name="ReportGrid" Background="White" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
     HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="28" ColumnHeaderHeight="26" ColumnHeaderStyle="{StaticResource ReportHeader}" HorizontalScrollBarVisibility="Auto" SizeChanged="ReportGrid_SizeChanged"/>
    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" IsHitTestVisible="False"/>
   </Grid>
   <Border Grid.Row="3" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}">
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="8,5" Foreground="{StaticResource UiMutedBrush}"/>
   </Border>
  </Grid>
 </Border>
</UserControl>
