<UserControl x:Class="MyPos.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:converters="clr-namespace:MyPos.Desktop.Converters"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <converters:UpperTextConverter x:Key="UpperText"/>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Background="#FEF9C3" BorderBrush="#EAB308"
                BorderThickness="0,1,0,0" Padding="14,7" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#422006" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DateTimeText" Grid.Column="1" FontSize="13"
                           FontWeight="SemiBold" Foreground="#422006"
                           Text="Thursday, October 1, 2026 · 7:10:24 PM"/>
            </Grid>
        </Border>

        <!-- Invoice header -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Invoice / OR No. *" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="InvoiceBox" Style="{StaticResource UpperBox}" Grid.Column="1" Height="32" MaxLength="24"
                         Tag="Invoice / OR No. — required"
                         TextChanged="InvoiceBox_TextChanged"/>
                <TextBlock Grid.Column="2" Text="Pay Mode" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="PayModeBox" Grid.Column="3" Height="32"/>
                <TextBlock Grid.Column="4" Text="Type" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="TypeBox" Grid.Column="5" Height="32"/>
                <TextBlock Grid.Row="1" Text="Customer" VerticalAlignment="Center" Margin="0,10,8,0"/>
                <TextBox x:Name="CustomerNameBox" Style="{StaticResource UpperBox}" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0"
                         Tag="Customer name (optional)"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Address" VerticalAlignment="Center" Margin="16,10,8,0"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource UpperBox}" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="6" Height="32" Margin="0,10,0,0"
                         Tag="Address (optional)"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- Search / scan — the scanner types a barcode + Enter, exactly like a keyboard -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Style="{StaticResource UpperBox}" Height="44" FontSize="18" Padding="36,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center"
                           Margin="12,0,0,0" IsHitTestVisible="False"
                           HorizontalAlignment="Left"/>
                <TextBlock Visibility="Collapsed" Text="Scan barcode or search product — Enter adds the top match"
                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"
                           Margin="36,0,0,0" IsHitTestVisible="False"
                           HorizontalAlignment="Left"/>
            </Grid>

            <!-- Product matches -->
            <DataGrid x:Name="ProductsGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White"
                      MouseDoubleClick="ProductsGrid_MouseDoubleClick"
                      KeyDown="ProductsGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat={}{0:0.##}}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Cart + totals -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="CartGrid" Grid.Row="0"
                          behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                          BorderThickness="1" BorderBrush="#E2E8F0" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Width="*">
                            <DataGridTextColumn.Binding><Binding Path="Name" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="QTY" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- MinWidth/MinHeight/Padding zeroed: the design-system button
                                             style would otherwise force these up to 88x34 -->
                                        <Button Content="−" Width="28" Height="28" FontSize="15"
                                                MinWidth="0" MinHeight="0" Padding="0"
                                                Click="QtyMinus_Click"/>
                                        <TextBox Text="{Binding Qty, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="46" Height="28" Padding="0" TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                                 Background="White" Margin="1,0"/>
                                        <Button Content="+" Width="28" Height="28"
                                                MinWidth="0" MinHeight="0" Padding="0"
                                                Click="QtyPlus_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Selling Price" ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="110"/>
                        <DataGridTextColumn Header="Amount" ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding LineTotal, StringFormat=₱{0:N2}}" Width="110"/>
                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            FontSize="13" Foreground="#DC2626" Background="Transparent"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            ToolTip="Remove this item" Click="RemoveLine_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MyPosButton}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Totals panel -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GrossText" Grid.Column="1" Text="₱0.00"
                                       Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Discount" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBox x:Name="DiscountBox" Grid.Column="1" Width="110" Height="30"
                                     TextAlignment="Right" VerticalContentAlignment="Center"
                                     Background="#1E293B" BorderBrush="#334155" Foreground="#E2E8F0"
                                     ToolTip="WHOLE-PESO DISCOUNT, DEDUCTED BEFORE VAT (THE VAT BASE SHRINKS WITH IT)"
                                     KeyDown="DiscountBox_KeyDown"
                                     TextChanged="DiscountBox_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VatLabel" Text="VAT" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VatText" Grid.Column="1" Text="₱0.00" Foreground="#E2E8F0"/>
                        </Grid>
                        <Border Background="#334155" Height="1" Margin="0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TotalText" Grid.Column="1" FontSize="17"
                                       FontWeight="Bold" Foreground="White" Text="₱0.00"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button x:Name="ClearButton" Content="Clear (F4)" Width="95" Height="40"
                                    Margin="0,0,10,0" Click="ClearButton_Click"/>
                            <Button x:Name="PayButton" Width="150" Height="40"
                                    Background="#0078D7" Foreground="White" BorderBrush="#0078D7"
                                    FontSize="15" FontWeight="SemiBold"
                                    IsEnabled="False" Click="PayButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pay  (F2)" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
