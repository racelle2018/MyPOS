<UserControl x:Class="MyPos.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:converters="clr-namespace:MyPos.Desktop.Converters"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <converters:UpperTextConverter x:Key="UpperText"/>
    </UserControl.Resources>
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Bottom" Background="#EAF1F7" BorderBrush="#B8C7D8"
                BorderThickness="0,1,0,0" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#334155" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DateTimeText" Grid.Column="1" FontSize="13"
                           FontWeight="SemiBold" Foreground="#334155"
                           Text="Thursday, October 1, 2026 · 7:10:24 PM"/>
            </Grid>
        </Border>

        <Border x:Name="ShiftBanner" DockPanel.Dock="Top" Background="#FEF3C7"
                BorderBrush="#F59E0B" BorderThickness="1" Padding="10,8"
                Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="OpenShiftButton" Content="Open Shift" DockPanel.Dock="Right" Height="32"
                        Click="OpenShiftButton_Click"/>
                <TextBlock x:Name="ShiftStatusText" VerticalAlignment="Center"
                           Foreground="#78350F" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Transaction fields and the live sale total, following the sales reference. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#B8C7D8"
                BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Invoice / OR No. *" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="InvoiceBox" Grid.Column="1" Height="32" MaxLength="24"
                                 Style="{StaticResource UpperBox}" Tag="Invoice / OR No. — required"
                                 TextChanged="InvoiceBox_TextChanged"/>
                        <TextBlock Grid.Column="2" Text="Pay Mode" VerticalAlignment="Center"
                                   Margin="14,0,8,0"/>
                        <ComboBox x:Name="PayModeBox" Grid.Column="3" Height="32"/>

                        <TextBlock Grid.Row="1" Text="Customer" VerticalAlignment="Center"
                                   Margin="0,8,8,0"/>
                        <TextBox x:Name="CustomerNameBox" Grid.Row="1" Grid.Column="1"
                                 Height="32" Margin="0,8,0,0" Style="{StaticResource UpperBox}"
                                 Tag="Customer name (optional)" TextChanged="CustomerNameBox_TextChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Delivery / Type"
                                   VerticalAlignment="Center" Margin="14,8,8,0"/>
                        <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="3"
                                  Height="32" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="2" Text="Address" VerticalAlignment="Center"
                                   Margin="0,8,8,0"/>
                        <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="1"
                                 Grid.ColumnSpan="3" Height="32" Margin="0,8,0,0"
                                 Style="{StaticResource UpperBox}" Tag="Address (optional)"/>

                        <TextBlock x:Name="SeniorIdLabel" Grid.Row="3" Text="SC/PWD ID"
                                   VerticalAlignment="Center" Margin="0,8,8,0"/>
                        <TextBox x:Name="SeniorIdBox" Grid.Row="3" Grid.Column="1"
                                 Height="32" Margin="0,8,0,0" IsEnabled="False"
                                 Style="{StaticResource UpperBox}"
                                 Tag="Senior/PWD ID number — required"/>
                        <TextBlock x:Name="InvoiceErrorText" Grid.Row="4" Grid.Column="1"
                                   Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SeniorIdErrorText" Grid.Row="4" Grid.Column="2"
                                   Grid.ColumnSpan="2" Foreground="#B91C1C"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#EAF1F7" BorderBrush="#B8C7D8"
                        BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="TOTAL AMOUNT" Foreground="#526071"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalText" Text="₱0.00" FontSize="30"
                                   FontWeight="Bold" Foreground="#1D4E72"
                                   TextAlignment="Right" Margin="0,0,0,5"/>
                        <Border Height="1" Background="#B8C7D8" Margin="0,0,0,5"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Before VAT" Foreground="#526071"/>
                            <TextBlock x:Name="NetText" Grid.Column="1" Text="₱0.00"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VatLabel" Text="VAT" Foreground="#526071"/>
                            <TextBlock x:Name="VatText" Grid.Column="1" Text="₱0.00"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="No. of items" Foreground="#526071"/>
                            <TextBlock x:Name="ItemCountText" Grid.Column="1" Text="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Search / scan — the scanner types a barcode + Enter, exactly like a keyboard -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource UpperBox}" Height="38" FontSize="15" Padding="34,0,10,0"
                         Tag="Scan barcode or search product — Enter adds the top match"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center"
                           Margin="12,0,0,0" IsHitTestVisible="False"
                           HorizontalAlignment="Left"/>
            </Grid>

            <!-- Product matches stay alongside the sale for mouse and keyboard selection. -->
            <DataGrid x:Name="ProductsGrid" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White"
                      MouseDoubleClick="ProductsGrid_MouseDoubleClick"
                      KeyDown="ProductsGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat={}{0:0.##}}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- The itemized sale is the primary working area. -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="CartGrid" Grid.Row="0"
                          behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                          BorderThickness="1" BorderBrush="#E2E8F0" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="100"/>
                        <DataGridTextColumn Header="Description" Width="*">
                            <DataGridTextColumn.Binding><Binding Path="Name" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="QTY" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- MinWidth/MinHeight/Padding zeroed: the design-system button
                                             style would otherwise force these up to 88x34 -->
                                        <Button Content="−" Width="28" Height="28" FontSize="15"
                                                MinWidth="0" MinHeight="0" Padding="0"
                                                Click="QtyMinus_Click"/>
                                        <TextBox Text="{Binding Qty, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="46" Height="28" Padding="0" TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                                 Background="White" Margin="1,0"/>
                                        <Button Content="+" Width="28" Height="28"
                                                MinWidth="0" MinHeight="0" Padding="0"
                                                Click="QtyPlus_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Price" ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="110"/>
                        <DataGridTextColumn Header="Line Amount" ElementStyle="{StaticResource RightCell}"
                                            Binding="{Binding LineTotal, StringFormat=₱{0:N2}}" Width="110"/>
                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            FontSize="13" Foreground="#DC2626" Background="Transparent"
                                            BorderBrush="Transparent" Cursor="Hand"
                                            ToolTip="Remove this item" Click="RemoveLine_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MyPosButton}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Discount and actions remain directly below the itemized sale. -->
                <Border Grid.Row="1" Background="#EAF1F7" BorderBrush="#B8C7D8"
                        BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="#526071" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GrossText" Grid.Column="1" Text="₱0.00"
                                       Foreground="#1F2937" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Discount" Foreground="#526071" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="DiscountKindBox" Width="110" Height="30" SelectionChanged="DiscountKindBox_SelectionChanged">
                                <ComboBoxItem Content="NONE"/><ComboBoxItem Content="AMOUNT"/><ComboBoxItem Content="SENIOR/PWD"/>
                            </ComboBox>
                            <TextBox x:Name="DiscountBox" Width="90" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Right" VerticalContentAlignment="Center"
                                     Background="White" BorderBrush="#AEBECD" Foreground="#1F2937"
                                     IsEnabled="False" ToolTip="WHOLE-PESO DISCOUNT, DEDUCTED BEFORE VAT"
                                     KeyDown="DiscountBox_KeyDown"
                                     TextChanged="DiscountBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button x:Name="HoldButton" Content="Hold (F3)" Width="95" Height="40" Margin="0,0,8,0" Click="HoldButton_Click"/>
                            <Button x:Name="RecallButton" Content="Recall (F6)" Width="130" Height="40" Margin="0,0,8,0" Click="RecallButton_Click"/>
                            <Button x:Name="ClearButton" Content="Clear (F4)" Width="95" Height="40"
                                    Margin="0,0,10,0" Click="ClearButton_Click"/>
                            <Button x:Name="PayButton" Width="150" Height="40"
                                    Background="#2878BD" Foreground="White" BorderBrush="#1F659F"
                                    FontSize="15" FontWeight="SemiBold"
                                    IsEnabled="False" Click="PayButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pay  (F2)" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
