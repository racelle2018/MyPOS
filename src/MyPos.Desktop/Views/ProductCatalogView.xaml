<UserControl x:Class="MyPos.Desktop.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ReceiveStockButton" Content="Receive Stock" Height="32"
                        MinWidth="100" Margin="4,0" Click="ReceiveStockButton_Click"/>
                <Button x:Name="EditButton" Content="Edit" Height="32"
                        MinWidth="80" Margin="4,0" Click="EditButton_Click"/>
                <Button x:Name="DeactivateButton" Content="Deactivate" Height="32"
                        MinWidth="90" Margin="4,0" Click="DeactivateButton_Click"/>
                <Button x:Name="AddButton" Content="Add Product" Height="32" MinWidth="100"
                        Margin="4,0" Background="#0F172A" Foreground="White"
                        Click="AddButton_Click"/>
            </StackPanel>
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="320" Height="32"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>
        </DockPanel>

        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>

        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="None"
                  BorderThickness="0" Background="White"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55"/>
                <DataGridTextColumn x:Name="CostColumn" Header="Cost"
                                    Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Stock"
                                    Binding="{Binding StockQty, StringFormat={}{0:0.##}}" Width="70"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
