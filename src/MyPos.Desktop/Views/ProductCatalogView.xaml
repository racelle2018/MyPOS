<UserControl x:Class="MyPos.Desktop.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:converters="clr-namespace:MyPos.Desktop.Converters"
             xmlns:app="clr-namespace:MyPos.Desktop">
    <UserControl.Resources>
        <converters:StockBrushConverter x:Key="StockBrush"/>
        <converters:UpperTextConverter x:Key="UpperText"/>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource UpperBox}" Width="320" Height="34"
                     Tag="Name, barcode, or category" Margin="0,0,12,4"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>
            <Button x:Name="ReceiveStockButton" Content="Receive Stock" Height="34"
                    MinWidth="100" Margin="4,0,4,4" Click="ReceiveStockButton_Click"/>
            <Button x:Name="EditButton" Height="34" MinWidth="0" Padding="12,0"
                    Margin="4,0,4,4" Click="EditButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Edit" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeactivateButton" Content="Deactivate" Height="34"
                    MinWidth="90" Margin="4,0,4,4" Click="DeactivateButton_Click"/>
            <Button x:Name="AddButton" Height="34" MinWidth="0" Padding="12,0"
                    Margin="4,0,4,4" Background="#2878BD" Foreground="White"
                    Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Add Product" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>

        <Grid>
        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="None"
                  BorderThickness="0" Background="White"
                  CanUserResizeColumns="True" SelectionChanged="ProductsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product Description" Width="*">
                    <DataGridTextColumn.Binding><Binding Path="Name" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                <DataGridTextColumn Header="Category" Width="110">
                    <DataGridTextColumn.Binding><Binding Path="Category" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55"/>
                <DataGridTextColumn x:Name="CostColumn" Header="Cost" ElementStyle="{StaticResource RightCell}"
                                    Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Selling Price" ElementStyle="{StaticResource RightCell}"
                                    Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTemplateColumn Header="Stock" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StockQty, StringFormat={}{0:0.##}}"
                                       HorizontalAlignment="Right"
                                       Foreground="{Binding StockQty, Converter={StaticResource StockBrush},
                                                    ConverterParameter={x:Static app:CurrentSettings.LowStockThreshold}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="70">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding ActiveText}" FontWeight="SemiBold" Foreground="{Binding ActiveBrush}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No products yet — add your first product"
                       Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
