<UserControl x:Class="MyPos.Desktop.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             xmlns:converters="clr-namespace:MyPos.Desktop.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:app="clr-namespace:MyPos.Desktop"
             FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12">
    <UserControl.Resources>
        <converters:StockBrushConverter x:Key="StockBrush"/>
        <converters:UpperTextConverter x:Key="UpperText"/>
        <Style x:Key="ProductToolbarButton" TargetType="Button"
               BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="ProductColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>
    <Border Margin="8,6,8,8" BorderBrush="#CDD1D4" BorderThickness="1"
            Background="White">
    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="0,0,0,1" Padding="6,3">
        <Grid x:Name="ToolbarGrid"
              SizeChanged="ToolbarGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SearchPanel" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource UpperBox}"
                         Height="28" Margin="0,5,0,5" FontSize="14" Padding="34,0,10,0"
                         Tag="Search barcode, product, or category"
                         materialDesign:HintAssist.Hint="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="12,0,0,0" Foreground="{StaticResource UiMutedBrush}"
                                         IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel x:Name="ActionsPanel" Grid.Column="1"
                       HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ReceiveStockButton" Content="Receive Stock"
                    Style="{StaticResource ProductToolbarButton}" Click="ReceiveStockButton_Click"
                    ToolTip="Select a product to receive stock" ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="EditButton" Style="{StaticResource ProductToolbarButton}"
                    Click="EditButton_Click"
                    ToolTip="Select a product to edit" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Edit" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeactivateButton" Content="Deactivate"
                    Style="{StaticResource ProductToolbarButton}" Click="DeactivateButton_Click"
                    ToolTip="Select a product to activate or deactivate" ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="AddButton" Style="{StaticResource ProductToolbarButton}"
                    Margin="0,5,0,5" Foreground="{StaticResource UiAccentBrush}"
                    BorderBrush="{StaticResource UiAccentBrush}"
                    Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Add Product" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </WrapPanel>
        </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="CountText" FontSize="11"
                       Foreground="{StaticResource UiMutedBrush}"/>
        </Border>

        <Grid>
        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  behaviors:DataGridBehaviors.DeselectOnOutsideClick="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="None"
                  BorderThickness="0" Background="White"
                  FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12"
                  RowHeight="28" ColumnHeaderHeight="26"
                  ColumnHeaderStyle="{StaticResource ProductColumnHeader}"
                  CanUserResizeColumns="True" SelectionChanged="ProductsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Product Description" Width="*" ElementStyle="{StaticResource GridCellText}">
                    <DataGridTextColumn.Binding><Binding Path="Name" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Width="110" ElementStyle="{StaticResource GridCellText}">
                    <DataGridTextColumn.Binding><Binding Path="Category" Converter="{StaticResource UpperText}"/></DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn x:Name="CostColumn" Header="Cost" ElementStyle="{StaticResource RightCell}"
                                    Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Selling Price" ElementStyle="{StaticResource RightCell}"
                                    Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="90"/>
                <DataGridTemplateColumn Header="Stock" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StockQty, StringFormat={}{0:0.##}}"
                                       HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="Foreground" Value="{Binding StockQty, Converter={StaticResource StockBrush}, ConverterParameter={x:Static app:CurrentSettings.LowStockThreshold}}"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Stock Level" Binding="{Binding StockLevelText}"
                                    Width="90" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTemplateColumn Header="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding ActiveText}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="Foreground" Value="{Binding ActiveBrush}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No products yet — add your first product"
                       Foreground="{StaticResource UiMutedBrush}" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
