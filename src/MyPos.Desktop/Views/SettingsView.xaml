<UserControl x:Class="MyPos.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
            <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
            <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontFamily" Value="{StaticResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="SettingsSaveButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingsSectionHeading" TargetType="TextBlock">
            <Setter Property="Background" Value="#CDD1D4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SettingsHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Border Margin="8,6,8,8" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4"
                    BorderThickness="{StaticResource UiBorderTopThickness}" Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SavedFeedbackText" FontSize="11"
                               Foreground="{StaticResource UiMutedBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Grid.Column="1" Content="Save Settings"
                            Style="{StaticResource SettingsSaveButton}" Click="SaveButton_Click"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SettingsSections" Margin="12" SizeChanged="SettingsSections_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftSettings" Margin="0,0,6,0">
                        <Border Style="{StaticResource SettingsSection}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Store details" Style="{StaticResource SettingsSectionHeading}"/>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Printed on receipts and reports." Style="{StaticResource SettingsHelp}"/>
                                        <TextBlock Text="Company / store name"/>
                                        <TextBox x:Name="CompanyNameBox"/>
                                        <TextBlock Text="Address"/>
                                        <TextBox x:Name="CompanyAddressBox"/>
                                        <TextBlock Text="TIN (leave blank if not VAT-registered)" TextWrapping="Wrap"/>
                                        <TextBox x:Name="CompanyTinBox"/>
                                        <TextBlock Text="Branch name (printed under the store name)" TextWrapping="Wrap"/>
                                        <TextBox x:Name="BranchNameBox"/>
                                        <TextBlock Text="BIR accreditation — leave blank until accredited"
                                                   Style="{StaticResource SettingsHelp}" Margin="0,6,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="ACCR NO." FontSize="11"/>
                                                <TextBox x:Name="AccrBox"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="MIN" FontSize="11"/>
                                                <TextBox x:Name="MinBox"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SN" FontSize="11"/>
                                                <TextBox x:Name="SnBox"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSection}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Inventory" Style="{StaticResource SettingsSectionHeading}"/>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Low-stock warning threshold"/>
                                        <TextBox x:Name="LowStockBox" Width="120" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="LowStockErrorText" Foreground="{StaticResource UiDangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="Products at or below this level show amber; zero shows red."
                                                   Style="{StaticResource SettingsHelp}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="RightSettings" Grid.Column="1" Margin="6,0,0,0">
                        <Border Style="{StaticResource SettingsSection}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Receipts and printer" Style="{StaticResource SettingsSectionHeading}"/>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ReceiptsEnabledBox" Margin="0,0,0,6">
                                            <TextBlock Text="Print system receipts — the system issues its own numbered invoices (Mode B)." TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="When OFF, you type manual OR/invoice numbers on each sale (Mode A)."
                                                   Style="{StaticResource SettingsHelp}"/>
                                        <TextBlock Text="Printer type"/>
                                        <ComboBox x:Name="PrintModeBox">
                                            <ComboBoxItem Content="Thermal receipt printer (ESC/POS)"/>
                                            <ComboBoxItem Content="Regular printer (any inkjet/laser)"/>
                                        </ComboBox>
                                        <TextBlock Text="Paper width"/>
                                        <ComboBox x:Name="WidthBox">
                                            <ComboBoxItem Content="58mm roll (32 characters)"/>
                                            <ComboBoxItem Content="80mm roll (48 characters)"/>
                                        </ComboBox>
                                        <TextBlock Text="Receipt printer"/>
                                        <ComboBox x:Name="PrinterBox"/>
                                        <TextBlock x:Name="PrinterWarningText" Foreground="{StaticResource UiDangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                                        <TextBlock Text="Blank = Windows default printer." Style="{StaticResource SettingsHelp}"/>
                                        <Button x:Name="TestReceiptButton" Content="Preview / Test Receipt"
                                                Style="{StaticResource SettingsButton}" HorizontalAlignment="Left"
                                                Click="TestReceiptButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSection}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Backup and recovery" Style="{StaticResource SettingsSectionHeading}"/>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="Second backup copy folder (external drive or synced folder)" TextWrapping="Wrap"/>
                                        <TextBox x:Name="BackupCopyFolderBox"
                                                 materialDesign:HintAssist.Hint="External drive or synced-folder path"/>
                                        <TextBlock Text="Local backups stay on this PC. Set a second location to protect against computer failure."
                                                   Style="{StaticResource SettingsHelp}"/>
                                        <WrapPanel>
                                            <Button x:Name="BackupButton" Content="Backup Now"
                                                    Style="{StaticResource SettingsButton}" Click="BackupButton_Click"/>
                                            <Button x:Name="RestoreButton" Content="Restore Backup"
                                                    Style="{StaticResource SettingsButton}" Click="RestoreButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="Recovery: choose a verified .db backup, confirm, then close and reopen MyPos. A pre-restore safety copy is made before the database is replaced. Keep a copy outside this computer."
                                                   Style="{StaticResource SettingsHelp}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
