<UserControl x:Class="MyPos.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,8">
                <TextBlock Text="STORE DETAILS — PRINTED ON RECEIPTS AND REPORTS" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Company / store name"/><TextBox x:Name="CompanyNameBox" Height="32" Margin="0,4,0,10"/>
            <TextBlock Text="Address"/><TextBox x:Name="CompanyAddressBox" Height="32" Margin="0,4,0,10"/>
            <TextBlock Text="TIN (leave blank if not VAT-registered)"/><TextBox x:Name="CompanyTinBox" Height="32" Margin="0,4,0,18"/>
            <TextBlock Text="Branch name (printed under the store name)"/><TextBox x:Name="BranchNameBox" Height="32" Margin="0,4,0,10"/>
            <TextBlock Text="BIR ACCREDITATION - leave blank until accredited" Foreground="#475569"/>
            <Grid Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="ACCR NO." FontSize="11"/><TextBox x:Name="AccrBox" Height="32"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="MIN" FontSize="11"/><TextBox x:Name="MinBox" Height="32"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SN" FontSize="11"/><TextBox x:Name="SnBox" Height="32"/></StackPanel></Grid>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,8">
                <TextBlock Text="RECEIPTS" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <CheckBox x:Name="ReceiptsEnabledBox" Margin="0,0,0,10">
                <TextBlock Text="Print system receipts — the system issues its own numbered invoices (Mode B)." TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="When OFF, you type manual OR/invoice numbers on each sale (Mode A)." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10"/>
            <TextBlock Text="Printer type"/><ComboBox x:Name="PrintModeBox" Height="32" Margin="0,4,0,10" Width="280"><ComboBoxItem Content="Thermal receipt printer (ESC/POS)"/><ComboBoxItem Content="Regular printer (any inkjet/laser)"/></ComboBox>
            <TextBlock Text="Paper width"/><ComboBox x:Name="WidthBox" Height="32" Margin="0,4,0,10" Width="220">
                <ComboBoxItem Content="58mm roll (32 characters)"/><ComboBoxItem Content="80mm roll (48 characters)"/>
            </ComboBox>
            <TextBlock Text="Receipt printer"/><ComboBox x:Name="PrinterBox" Height="32" Margin="0,4,0,4" Width="320"/>
            <TextBlock x:Name="PrinterWarningText" Foreground="#B91C1C" TextWrapping="Wrap"
                       Margin="0,0,0,4" Visibility="Collapsed"/>
            <TextBlock Text="Blank = Windows default printer." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,18"/>
            <Button Content="Preview / Test Receipt" Width="170" Height="34"
                    Margin="0,0,0,18" HorizontalAlignment="Left"
                    Click="TestReceiptButton_Click"/>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,8">
                <TextBlock Text="BACKUP AND RECOVERY" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Second backup copy folder (external drive or synced folder)"/>
            <TextBox x:Name="BackupCopyFolderBox" Height="34" Margin="0,4,0,4"
                     mah:TextBoxHelper.Watermark="External drive or synced-folder path"/>
            <TextBlock Text="Local backups stay on this PC. Set a second location to protect against computer failure."
                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button x:Name="BackupButton" Content="Backup Now" Width="110" Height="38"
                        Click="BackupButton_Click"/>
                <Button x:Name="RestoreButton" Content="Restore Backup" Width="125" Height="38"
                        Margin="10,0,0,0" Click="RestoreButton_Click"/>
            </StackPanel>
            <TextBlock Text="Recovery: choose a verified .db backup, confirm, then close and reopen MyPos. A pre-restore safety copy is made before the database is replaced. Keep a copy outside this computer."
                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,8">
                <TextBlock Text="INVENTORY" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Low-stock warning threshold"/><TextBox x:Name="LowStockBox" Height="32" Width="120" Margin="0,4,0,4"/>
            <TextBlock Text="Products at or below this level show amber; zero shows red." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="SaveButton" Content="Save Settings" Width="130" Height="34"
                        Background="#2878BD" Foreground="White" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
