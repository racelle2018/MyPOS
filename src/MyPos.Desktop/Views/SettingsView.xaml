<UserControl x:Class="MyPos.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="560">
            <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="STORE DETAILS" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBlock Text="Company name" Margin="0,10,0,0"/><TextBox x:Name="CompanyNameBox"/>
            <TextBlock Text="Address" Margin="0,10,0,0"/><TextBox x:Name="CompanyAddressBox"/>
            <TextBlock Text="TIN" Margin="0,10,0,0"/><TextBox x:Name="CompanyTinBox"/>
            <TextBlock Text="Receipt footer" Margin="0,10,0,0"/><TextBox x:Name="FooterMessageBox"/>
            <TextBlock Text="RECEIPTS" FontWeight="SemiBold" Foreground="#475569" Margin="0,20,0,8"/>
            <CheckBox x:Name="ReceiptsEnabledBox" Content="Print system receipts"/>
            <TextBlock Text="Paper width" Margin="0,10,0,0"/>
            <ComboBox x:Name="WidthBox"><ComboBoxItem Content="58mm (32 characters)"/><ComboBoxItem Content="80mm (48 characters)"/></ComboBox>
            <TextBlock Text="Printer name (blank uses Windows default)" Margin="0,10,0,0"/>
            <TextBox x:Name="PrinterNameBox"/>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Backup Now" Width="110" Margin="0,0,10,0" Click="BackupButton_Click"/>
                <Button Content="Save Settings" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
