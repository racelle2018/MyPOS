<UserControl x:Class="MyPos.Desktop.Views.ShiftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="SHIFT" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
            <Border Background="White" BorderBrush="#B8C7D8" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="StatusHeader" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDetail" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenShiftButton" Content="Open Shift (X-Reading)" Height="36" Padding="14,0" Margin="0,0,8,0" Click="OpenShiftButton_Click"/>
                        <Button x:Name="CashIOButton" Content="Cash In / Out" Height="36" Padding="14,0" Margin="0,0,8,0" Click="CashIOButton_Click"/>
                        <Button x:Name="CloseShiftButton" Content="Close Shift (Z-Reading)" Height="36" Padding="14,0" Click="CloseShiftButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <StackPanel><TextBlock Text="CASH SALES" Foreground="#64748B"/><TextBlock x:Name="CashSalesText" FontSize="16" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="NON-CASH SALES" Foreground="#64748B"/><TextBlock x:Name="NonCashText" FontSize="16" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="TRANSACTIONS" Foreground="#64748B"/><TextBlock x:Name="TxnText" FontSize="16" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,10,0,0"><TextBlock Text="CASH IN" Foreground="#64748B"/><TextBlock x:Name="CashInText" FontSize="16" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,10,0,0"><TextBlock Text="CASH OUT" Foreground="#64748B"/><TextBlock x:Name="CashOutText" FontSize="16" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,10,0,0"><TextBlock Text="EXPECTED DRAWER" Foreground="#64748B"/><TextBlock x:Name="ExpectedText" FontSize="16" FontWeight="Bold"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="RECENT SHIFTS" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
            <DataGrid x:Name="ShiftsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" MinHeight="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Opened" Binding="{Binding OpenedText}" Width="150"/>
                    <DataGridTextColumn Header="Closed" Binding="{Binding ClosedText}" Width="150"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserText}" Width="100"/>
                    <DataGridTextColumn Header="Float" Binding="{Binding OpeningFloat, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedDrawer, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Counted" Binding="{Binding CountedDrawer, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Variance" Binding="{Binding VarianceText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
