<UserControl x:Class="MyPos.Desktop.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="ShiftActionButton" TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="ShiftOpenAction" TargetType="Button" BasedOn="{StaticResource ShiftActionButton}">
            <Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
        </Style>
        <Style x:Key="ShiftMetricCard" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
        </Style>
        <Style x:Key="ShiftMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
        </Style>
        <Style x:Key="ShiftMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="ShiftColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>
    <Border Margin="8,6,8,8" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Background="White">
        <Grid SizeChanged="ShiftLayout_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#EEF0F1" BorderBrush="#CDD1D4"
                    BorderThickness="{StaticResource UiBorderBottomThickness}" Padding="8,3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,3,10,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                                    Foreground="{StaticResource UiAccentBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusHeader" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" Foreground="{StaticResource UiMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="ShiftActions" Grid.Column="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button x:Name="OpenShiftButton" Content="Open Shift (X-Reading)"
                                Style="{StaticResource ShiftOpenAction}"
                                Click="OpenShiftButton_Click"/>
                        <Button x:Name="CashIOButton" Content="Cash In / Out"
                                Style="{StaticResource ShiftActionButton}" Click="CashIOButton_Click"/>
                        <Button x:Name="CloseShiftButton" Content="Close Shift (Z-Reading)"
                                Style="{StaticResource ShiftActionButton}" Margin="0,5,0,5"
                                Click="CloseShiftButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <UniformGrid x:Name="ShiftTotals" Grid.Row="1" Columns="6">
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH SALES" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="CashSalesText" Style="{StaticResource ShiftMetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="NON-CASH SALES" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="NonCashText" Style="{StaticResource ShiftMetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="TRANSACTIONS" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="TxnText" Style="{StaticResource ShiftMetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH IN" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="CashInText" Style="{StaticResource ShiftMetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH OUT" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="CashOutText" Style="{StaticResource ShiftMetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="EXPECTED DRAWER" Style="{StaticResource ShiftMetricLabel}"/>
                        <TextBlock x:Name="ExpectedText" Style="{StaticResource ShiftMetricValue}" Foreground="{StaticResource UiAccentBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Background="#EEF0F1" BorderBrush="#CDD1D4"
                    BorderThickness="{StaticResource UiBorderBottomThickness}" Padding="8,5">
                <TextBlock Text="Recent shifts" FontWeight="SemiBold"/>
            </Border>
            <Grid Grid.Row="3">
                <DataGrid x:Name="ShiftsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column"
                          FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12"
                          RowHeight="28" ColumnHeaderHeight="26" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource ShiftColumnHeader}" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Opened" Binding="{Binding OpenedText}" Width="1.5*" MinWidth="130" ElementStyle="{StaticResource GridCellText}"/>
                        <DataGridTextColumn Header="Closed" Binding="{Binding ClosedText}" Width="1.5*" MinWidth="130" ElementStyle="{StaticResource GridCellText}"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserText}" Width="*" MinWidth="90" ElementStyle="{StaticResource GridCellText}"/>
                        <DataGridTextColumn Header="Float" Binding="{Binding OpeningFloat, StringFormat=₱{0:N2}}" Width="*" MinWidth="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedDrawer, StringFormat=₱{0:N2}}" Width="*" MinWidth="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Counted" Binding="{Binding CountedDrawer, StringFormat=₱{0:N2}}" Width="*" MinWidth="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Variance" Binding="{Binding VarianceText}" Width="*" MinWidth="90" ElementStyle="{StaticResource RightCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyHint" Text="No shifts recorded yet" Visibility="Collapsed"
                           Foreground="{StaticResource UiMutedBrush}" FontSize="13" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="4" Background="#EEF0F1" BorderBrush="#CDD1D4"
                    BorderThickness="{StaticResource UiBorderTopThickness}" Padding="8,3">
                <TextBlock x:Name="CountText" FontSize="11" Foreground="{StaticResource UiMutedBrush}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
