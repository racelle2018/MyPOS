<UserControl x:Class="MyPos.Desktop.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="ShiftMetricCard" TargetType="Border">
            <Setter Property="Width" Value="210"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Text="SHIFT" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
            <TextBlock Text="Monitor the current drawer and review recent shifts."
                       Style="{StaticResource FieldHint}" Margin="0,0,0,16"/>

            <Border Background="{StaticResource UiSurfaceBrush}"
                    BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                                 Foreground="{StaticResource UiAccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusHeader" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Foreground="{StaticResource UiMutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <WrapPanel>
                        <Button x:Name="OpenShiftButton" Content="Open Shift (X-Reading)"
                                Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0"
                                Margin="0,0,8,8" Click="OpenShiftButton_Click"/>
                        <Button x:Name="CashIOButton" Content="Cash In / Out"
                                Height="38" Padding="14,0" Margin="0,0,8,8"
                                Click="CashIOButton_Click"/>
                        <Button x:Name="CloseShiftButton" Content="Close Shift (Z-Reading)"
                                Height="38" Padding="14,0" Margin="0,0,8,8"
                                Click="CloseShiftButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="CURRENT SHIFT TOTALS" Style="{StaticResource SectionHeading}"
                       Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10">
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH SALES" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="CashSalesText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="NON-CASH SALES" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="NonCashText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="TRANSACTIONS" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="TxnText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH IN" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="CashInText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CASH OUT" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="CashOutText" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ShiftMetricCard}">
                    <StackPanel>
                        <TextBlock Text="EXPECTED DRAWER" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="ExpectedText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource UiAccentBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="RECENT SHIFTS" Style="{StaticResource SectionHeading}"
                       Margin="0,0,0,8"/>
            <DataGrid x:Name="ShiftsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" RowHeaderWidth="0" MinHeight="180"
                      Background="{StaticResource UiSurfaceBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Opened" Binding="{Binding OpenedText}" Width="150" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Closed" Binding="{Binding ClosedText}" Width="150" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserText}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Float" ElementStyle="{StaticResource RightCell}"
                                        Binding="{Binding OpeningFloat, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Expected" ElementStyle="{StaticResource RightCell}"
                                        Binding="{Binding ExpectedDrawer, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Counted" ElementStyle="{StaticResource RightCell}"
                                        Binding="{Binding CountedDrawer, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Variance" ElementStyle="{StaticResource RightCell}"
                                        Binding="{Binding VarianceText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
