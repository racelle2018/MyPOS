<UserControl x:Class="MyPos.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditButton" Content="Edit" Height="32" Padding="12,0" Margin="4,0" Click="EditButton_Click"/>
                <Button x:Name="ToggleActiveButton" Content="Deactivate" Height="32" Padding="12,0" Margin="4,0" Click="ToggleActiveButton_Click"/>
                <Button x:Name="AddButton" Height="32" Padding="12,0" Margin="4,0" Background="#0F172A" Foreground="White" Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/><TextBlock Text="Add User" Margin="7,0,0,0"/></StackPanel>
                </Button>
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="280" Height="32" Tag="Search users" TextChanged="SearchBox_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>
        <Grid>
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" behaviors:DataGridBehaviors.DeselectOnOutsideClick="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="1" BorderBrush="#E2E8F0" SelectionChanged="UsersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="110"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="90"/>
                    <DataGridTemplateColumn Header="Status" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginText}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No users yet — add your first user" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
