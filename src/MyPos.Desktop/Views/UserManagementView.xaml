<UserControl x:Class="MyPos.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="240" Height="34" Margin="0,0,8,4"
                     Tag="Search users" TextChanged="SearchBox_TextChanged"/>
            <CheckBox x:Name="ShowInactiveBox" Content="Show inactive" Margin="6,0,12,4"
                      VerticalAlignment="Center" Checked="ShowInactiveBox_Changed"
                      Unchecked="ShowInactiveBox_Changed"/>
            <Button x:Name="EditButton" Content="Edit" Height="34" Padding="12,0"
                    Margin="4,0,4,4" Click="EditButton_Click"
                    ToolTip="Select a user to edit" ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="ToggleActiveButton" Content="Deactivate" Height="34"
                    Padding="12,0" Margin="4,0,4,4" Click="ToggleActiveButton_Click"
                    ToolTip="Select a user to activate or deactivate"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="AddButton" Height="34" Padding="12,0" Margin="4,0,4,4"
                    Style="{StaticResource PrimaryButton}" Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                    <TextBlock Text="Add User" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>
        <Grid>
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" behaviors:DataGridBehaviors.DeselectOnOutsideClick="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="1" BorderBrush="#E2E8F0" SelectionChanged="UsersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                            <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginText}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No users yet — add your first user" Foreground="{StaticResource UiMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
