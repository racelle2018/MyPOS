<UserControl x:Class="MyPos.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:MyPos.Desktop.Controls"
             FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="UserActionButton" TargetType="Button" BasedOn="{StaticResource ReportChromeButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="UserColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#EEF0F1"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>
    <Border Margin="8,6,8,8" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="{StaticResource UiBorderBottomThickness}" Padding="6,3">
        <Grid x:Name="ToolbarGrid" SizeChanged="ToolbarGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SearchPanel" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox" Height="28" Margin="0,5,0,5"
                         FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12"
                         Padding="34,0,10,0" Tag="Search username or full name"
                         TextChanged="SearchBox_TextChanged"/>
                <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                        Margin="12,0,0,0" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Foreground="{StaticResource UiMutedBrush}"
                                        IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel x:Name="ActionsPanel" Grid.Column="1" HorizontalAlignment="Right"
                       VerticalAlignment="Center">
            <CheckBox x:Name="ShowInactiveBox" Content="Show inactive" Margin="0,5,12,5"
                      FontFamily="{StaticResource ReportInterFontFamily}" FontSize="12"
                      VerticalAlignment="Center" Checked="ShowInactiveBox_Changed"
                      Unchecked="ShowInactiveBox_Changed"/>
            <Button x:Name="EditButton" Content="Edit" Style="{StaticResource UserActionButton}"
                    Click="EditButton_Click"
                    ToolTip="Select a user to edit" ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="ToggleActiveButton" Content="Deactivate"
                    Style="{StaticResource UserActionButton}" Click="ToggleActiveButton_Click"
                    ToolTip="Select a user to activate or deactivate"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="AddButton" Margin="0,5,0,5" Style="{StaticResource UserActionButton}"
                    Foreground="{StaticResource UiAccentBrush}" BorderBrush="{StaticResource UiAccentBrush}"
                    Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Add User" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </WrapPanel>
        </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4"
                BorderThickness="{StaticResource UiBorderTopThickness}" Padding="8,3">
            <TextBlock x:Name="CountText" FontSize="11" Foreground="{StaticResource UiMutedBrush}"/>
        </Border>
        <Grid>
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      behaviors:DataGridBehaviors.DeselectOnOutsideClick="True" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                      BorderThickness="0" Background="White" FontFamily="{StaticResource ReportInterFontFamily}"
                      FontSize="12" RowHeight="28" ColumnHeaderHeight="26"
                      ColumnHeaderStyle="{StaticResource UserColumnHeader}" SelectionChanged="UsersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                            <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginText}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="No users yet — add your first user" Foreground="{StaticResource UiMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
