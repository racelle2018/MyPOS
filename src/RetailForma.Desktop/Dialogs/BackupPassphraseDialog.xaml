<Window x:Class="RetailForma.Desktop.Dialogs.BackupPassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/RetailForma.Desktop;component/Assets/Branding/retailforma.ico"
        Style="{DynamicResource DialogWindow}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="16" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="88" IsCancel="True" Margin="0,5,8,5"/>
            <Button x:Name="SavePassphraseButton" Content="Save" Width="88" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
                <StackPanel x:Name="CurrentPanel">
                    <TextBlock Text="Current passphrase"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Height="{DynamicResource UiControlHeight34}" Margin="0,4,0,8"
                                 AutomationProperties.Name="Current backup recovery passphrase" PasswordChanged="Current_Changed"/>
                    <Button x:Name="VerifyCurrentButton" Content="Verify current passphrase" HorizontalAlignment="Left" Click="Verify_Click"/>
                    <TextBlock x:Name="VerifiedText" Text="Current passphrase verified." Foreground="{StaticResource UiSuccessBrush}" Visibility="Collapsed" Margin="0,4,0,8"/>
                </StackPanel>
                <StackPanel x:Name="NewFieldsPanel" Margin="0,8,0,0">
                    <TextBlock Text="New passphrase (16–256 characters)"/>
                    <PasswordBox x:Name="NewPasswordBox" Height="{DynamicResource UiControlHeight34}" Margin="0,4,0,10" AutomationProperties.Name="New backup recovery passphrase"/>
                    <TextBlock Text="Confirm new passphrase"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="{DynamicResource UiControlHeight34}" Margin="0,4,0,10" AutomationProperties.Name="Confirm new backup recovery passphrase"/>
                    <TextBlock Text="Keep a secure independent copy. Existing ZIP backups still need their original passphrase."
                               TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
