<Window x:Class="RetailForma.Desktop.Dialogs.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore backup" Width="400" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/RetailForma.Desktop;component/Assets/Branding/retailforma.ico"
        Style="{DynamicResource DialogWindow}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="16" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="88" IsCancel="True" Margin="0,5,8,5"/>
            <Button x:Name="RestoreActionButton" Content="Restore" Width="88" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Restore_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Restore encrypted backup" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
                <TextBlock Text="Selected backup"/>
                <TextBlock x:Name="BackupFileText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,12"/>
                <TextBlock x:Name="PassphraseLabel" Text="Backup passphrase"/>
                <PasswordBox x:Name="BackupPasswordBox" Height="{DynamicResource UiControlHeight34}" Margin="0,4,0,10" AutomationProperties.Name="Selected backup passphrase"/>
                <TextBlock x:Name="PassphraseHelp" Text="Enter the passphrase used when this ZIP was created. It may differ from your current recovery passphrase. This entry is not saved."
                           TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
