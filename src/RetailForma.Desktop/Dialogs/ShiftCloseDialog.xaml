<Window x:Class="RetailForma.Desktop.Dialogs.ShiftCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Shift" Width="420" Height="600" MaxHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{DynamicResource DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12,16,8">
            <TextBlock Text="CLOSE SHIFT" FontSize="{DynamicResource UiFontSize14}" FontWeight="SemiBold"/>
            <TextBlock x:Name="ShiftIdentityText" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="ClosingOperatorText" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Count the physical drawer cash before closing." Style="{StaticResource FieldHint}"
                       Margin="0,4,0,12"/>
            <Border Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Opening float"/>
                    <TextBlock x:Name="FloatText" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="Net cash sales"/>
                    <TextBlock x:Name="CashSalesText" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Cash in"/>
                    <TextBlock x:Name="CashInText" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Grid.Row="3" Text="Cash out"/>
                    <TextBlock x:Name="CashOutText" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Grid.Row="4" Text="Expected cash" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ExpectedText" Grid.Row="4" Grid.Column="1" TextAlignment="Right" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock x:Name="VoidText" Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" Style="{StaticResource FieldHint}" Margin="0,6,0,0"/>
                </Grid>
            </Border>
            <TextBlock Text="Counted drawer cash (₱)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <CheckBox x:Name="UseDenominationsBox" Content="Count by bills / coins" Margin="0,5,0,5" Checked="UseDenominations_Changed" Unchecked="UseDenominations_Changed"/>
            <DataGrid x:Name="DenominationGrid" Visibility="Collapsed" Height="180" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="{DynamicResource UiTableRowHeight28}" ColumnHeaderHeight="{DynamicResource UiTableHeaderHeight26}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Face value" Binding="{Binding FaceValue, StringFormat=₱{0:N2}}" IsReadOnly="True" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="CountedBox" Height="{DynamicResource UiControlHeight40}" Tag="Counted cash in drawer"
                     AutomationProperties.Name="Counted drawer cash"
                     TextChanged="CountedBox_TextChanged"/>
            <TextBlock Text="Notes (optional)" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <TextBox x:Name="NotesBox" Height="60" Margin="0,0,0,8" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="10,7"
                     Tag="Notes about this shift (optional)"
                     AutomationProperties.Name="Shift notes"/>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}" Padding="16,4">
        <StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource UiDangerBrush}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock x:Name="VariancePreview" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Height="{DynamicResource UiControlHeight32}" Content="Cancel" IsCancel="True" Width="80" Margin="0,5,8,5"/>
                <Button x:Name="CloseShiftButton" Height="{DynamicResource UiControlHeight32}" Content="Close Shift" IsDefault="True" Width="110"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>
