<Window x:Class="RetailForma.Desktop.Dialogs.StockAdjustmentDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Stock Adjustment" Width="420" SizeToContent="Height" MaxHeight="650" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Style="{DynamicResource DialogWindow}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/DialogChrome.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#EEF0F1"><StackPanel Margin="16">
  <TextBlock x:Name="ProductText" TextWrapping="Wrap" FontWeight="SemiBold"/>
  <TextBlock Text="Signed quantity change (negative for shortage/damage)" TextWrapping="Wrap" Margin="0,10,0,4"/>
  <TextBox x:Name="QuantityBox" Tag="Example: -2" Height="{DynamicResource UiControlHeight34}"/>
  <TextBlock Text="Surplus counterpart (investigate source first)" Margin="0,10,0,4"/>
  <ComboBox x:Name="CounterpartBox" DisplayMemberPath="Value" SelectedValuePath="Key" Height="{DynamicResource UiControlHeight34}"/>
  <TextBlock Text="Missed purchases must use Receive Stock. Opening clearing corrections require later reconciliation; surplus is not automatically income." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,6,0,8"/>
  <TextBox x:Name="ReasonBox" Tag="Reason and valuation/source evidence" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
  <CheckBox x:Name="ZeroCostBox" Content="Verified genuine zero carrying cost" Margin="0,10,0,8"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Height="{DynamicResource UiControlHeight32}" Margin="0,5,8,5"/>
   <Button Content="Approve adjustment" IsDefault="True" Height="{DynamicResource UiControlHeight32}" Margin="0,5,0,5" Click="Save_Click"/>
  </StackPanel>
 </StackPanel></ScrollViewer>
</Window>
