<UserControl x:Class="RetailForma.Desktop.Views.BackupRestoreView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}" Foreground="{StaticResource UiTextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12">                        <Border Style="{StaticResource SettingsSection}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Backup &amp; Restore" Style="{StaticResource SettingsSectionHeading}"/>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="Recovery passphrase"/>
                                        <TextBlock x:Name="PassphraseStatusText" Foreground="{StaticResource UiMutedBrush}" Margin="0,4,0,0"/>
                                        <Button x:Name="PassphraseActionButton" Content="Set passphrase" HorizontalAlignment="Left" Style="{StaticResource SettingsButton}" Click="Passphrase_Click"/>
                                        <TextBlock Text="Additional backup copy folder (optional external drive or existing destination)" TextWrapping="Wrap"/>
                                        <TextBox x:Name="BackupCopyFolderBox"
                                                 materialDesign:HintAssist.Hint="External drive or synced-folder path"/>
                                        <CheckBox x:Name="GoogleDriveEnabledBox" Content="Copy to Google Drive sync folder"/>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Browse" Tag="GoogleDrive" Style="{StaticResource SettingsButton}" Click="BrowseFolder_Click"/>
                                            <TextBox x:Name="GoogleDriveFolderBox" materialDesign:HintAssist.Hint="Dedicated Google Drive backup folder"/>
                                        </DockPanel>
                                        <TextBlock x:Name="GoogleDriveStatusText" Style="{StaticResource SettingsHelp}"/>
                                        <CheckBox x:Name="DropboxEnabledBox" Content="Copy to Dropbox sync folder"/>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Browse" Tag="Dropbox" Style="{StaticResource SettingsButton}" Click="BrowseFolder_Click"/>
                                            <TextBox x:Name="DropboxFolderBox" materialDesign:HintAssist.Hint="Dedicated Dropbox backup folder"/>
                                        </DockPanel>
                                        <TextBlock x:Name="DropboxStatusText" Style="{StaticResource SettingsHelp}"/>
                                        <TextBlock Text="Enable either or both. Sign in to the provider's desktop app and select its locally available backup folder. RetailForma verifies encrypted ZIP copies only; check cloud sync in Google Drive/Dropbox. Never sync the live database."
                                                   Style="{StaticResource SettingsHelp}"/>
                                        <WrapPanel>
                                            <Button x:Name="BackupButton" Content="Backup Now"
                                                    Style="{StaticResource SettingsButton}" Click="BackupButton_Click"/>
                                            <Button x:Name="RestoreButton" Content="Restore Backup"
                                                    Style="{StaticResource SettingsButton}" Click="RestoreButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="Recovery: choose an encrypted ZIP (or legacy .db), confirm, then close and reopen RetailForma. Save a recovery passphrase first for the encrypted pre-restore safety copy. Re-save the passphrase after recovery on another Windows profile."
                                                   Style="{StaticResource SettingsHelp}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

    <Button x:Name="SavePreferencesButton" Content="Save backup preferences" Style="{StaticResource SettingsSaveButton}" HorizontalAlignment="Left" Click="SaveButton_Click"/>
    <TextBlock x:Name="SavedFeedbackText" TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/></StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
