<UserControl x:Class="RetailForma.Desktop.Views.CashDrawerSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}" Foreground="{StaticResource UiTextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12">
    <Border Style="{StaticResource SettingsSection}">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Drawer access settings" Style="{StaticResource SettingsSectionHeading}"/>
      <StackPanel Margin="12,10" MaxWidth="600" HorizontalAlignment="Left">
       <TextBlock x:Name="CurrentPolicyText" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock Text="Drawer access for the next shift" FontWeight="SemiBold"/>
       <ComboBox x:Name="DrawerModeBox" SelectionChanged="DrawerModeBox_SelectionChanged" MinWidth="250">
        <ComboBoxItem Content="Shared — all cashiers"/><ComboBoxItem Content="Assigned — one cashier"/>
       </ComboBox>
       <StackPanel x:Name="AssignedCashierPanel">
        <TextBlock Text="Assigned cashier"/>
        <ComboBox x:Name="AssignedCashierBox" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
       </StackPanel>
       <TextBlock Text="Changes apply when the next shift opens. An open shift keeps its existing policy. Administrators can access either drawer type."
                  Style="{StaticResource SettingsHelp}"/>
       <Button Content="Save drawer policy" Style="{StaticResource SettingsSaveButton}" HorizontalAlignment="Left" Click="SaveButton_Click"/>
       <TextBlock x:Name="SavedFeedbackText" TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
      </StackPanel>
     </DockPanel>
    </Border></StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
