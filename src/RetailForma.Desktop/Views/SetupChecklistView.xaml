<UserControl x:Class="RetailForma.Desktop.Views.SetupChecklistView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{DynamicResource ReportInterFontFamily}" FontSize="{DynamicResource UiFontSize12}" Foreground="{StaticResource UiTextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Margin="8,6,8,8" Background="White" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12">
    <TextBlock Text="Setup &amp; Recovery" Style="{StaticResource SettingsSectionHeading}"/>
    <TextBlock Margin="0,10,0,8" Text="Single-computer Basic · Philippine peso · Asia/Manila. This checklist does not block checkout or certify accounting, licensing, hardware, or cloud recovery." Style="{StaticResource SettingsHelp}"/>
    <ItemsControl x:Name="ChecklistItems">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#CDD1D4" BorderThickness="0,0,0,1" Padding="4,8">
       <StackPanel>
        <CheckBox IsChecked="{Binding Confirmed, Mode=TwoWay}" Content="{Binding Title}"/>
        <TextBlock Text="{Binding Guidance}" Margin="24,4,0,0" Style="{StaticResource SettingsHelp}"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="SaveReviewButton" Content="Save review" HorizontalAlignment="Left" Style="{StaticResource SettingsSaveButton}" Click="Save_Click"/>
    <TextBlock Text="Recovery procedure" Style="{StaticResource SettingsSectionHeading}" Margin="0,12,0,8"/>
    <TextBlock x:Name="RecoveryText" Style="{StaticResource SettingsHelp}"/>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
