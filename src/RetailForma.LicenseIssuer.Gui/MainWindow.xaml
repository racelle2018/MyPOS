<Window x:Class="RetailForma.LicenseIssuer.Gui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RetailForma License Generator" Icon="Assets/Branding/retailforma.ico" Width="760" Height="650" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Styles/UtilitySettingsChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="8" Background="#EEF0F1">
  <Border DockPanel.Dock="Top" Background="#CDD1D4" Padding="12,7">
   <DockPanel>
    <Image x:Name="RetailFormaLogo" DockPanel.Dock="Left" Source="Assets/Branding/retailforma-icon.png" Width="24" Height="24" Margin="0,0,8,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="RetailForma logo"/>
    <TextBlock Text="License Generator — Programmer" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <TextBlock DockPanel.Dock="Top" Text="Private signing keys stay on your controlled computer. Never distribute this tool with the customer POS." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="8,8,8,10"/>
  <Border DockPanel.Dock="Bottom" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}" Margin="0,8,0,0" Padding="8,6">
   <TextBlock x:Name="StatusText" Text="Ready. Load a device request to begin." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
  </Border>
  <TabControl x:Name="Pages">
   <TabItem Header="Generate license">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}" Padding="12,4">
      <Button x:Name="GenerateButton" Content="Generate lifetime license" HorizontalAlignment="Right" Style="{StaticResource SettingsSaveButton}" Click="Generate_Click"/>
     </Border>
     <ScrollViewer x:Name="GenerateScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12">
       <TextBlock Text="Issue a paid lifetime license" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock Text="Complete these fields from top to bottom. Company and fingerprint are filled from the POS request and are read-only." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
       <TextBlock Text="1. Load the POS device request" FontWeight="SemiBold"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="Request_Click"/><TextBox x:Name="RequestPathBox" IsReadOnly="True" Tag="Select the exported POS request (.json)"/></DockPanel>
       <TextBlock Text="Request company (read-only)"/><TextBox x:Name="CompanyBox" IsReadOnly="True"/>
       <TextBlock Text="Device fingerprint (read-only)"/><TextBox x:Name="FingerprintBox" IsReadOnly="True" TextWrapping="Wrap" Height="48"/>
       <TextBlock Text="2. Select the paid lifetime signing key" FontWeight="SemiBold" Margin="0,8,0,0"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="Key_Click"/><TextBox x:Name="KeyPathBox" IsReadOnly="True" Tag="Encrypted paid private key (.pem)"/></DockPanel>
       <TextBlock Text="3. Review the entitlement" FontWeight="SemiBold"/>
       <TextBlock Text="Entitlement ID (generated automatically; keep the same ID for an approved device replacement)" TextWrapping="Wrap"/>
       <DockPanel><Button x:Name="NewIdButton" DockPanel.Dock="Right" Content="New ID" Margin="8,5,0,10" Click="NewId_Click"/><TextBox x:Name="EntitlementBox"/></DockPanel>
       <CheckBox x:Name="ReplaceBox" Content="Approved hardware replacement (existing entitlement)" Margin="0,4,0,10" Checked="Replacement_Changed" Unchecked="Replacement_Changed"/>
       <CheckBox x:Name="PortalBox" Content="Owner portal entitlement" Margin="0,0,0,10"/>
       <TextBlock Text="4. Choose Generate lifetime license. Verify the purchase and device, choose where to save the signed license, then enter the paid key passphrase. The customer receives only the signed JSON. Lifetime licenses do not expire or require online renewal." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="Signing keys">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}" Padding="12,4">
      <Button x:Name="CreateKeysButton" Content="Create encrypted key pair" HorizontalAlignment="Right" Style="{StaticResource SettingsSaveButton}" Click="CreateKeys_Click"/>
     </Border>
     <ScrollViewer x:Name="KeysScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12">
       <TextBlock Text="Create signing and recovery keys" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock Text="Follow the steps in order. Create separate keys for each purpose; existing key folders are never overwritten." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
       <TextBlock Text="1. Select the key purpose" FontWeight="SemiBold"/>
       <ComboBox x:Name="PurposeBox" SelectedIndex="0"><ComboBoxItem Content="Paid lifetime — keep private key offline"/><ComboBoxItem Content="Online trial — separate server key"/><ComboBoxItem Content="Developer recovery — separate from licensing"/></ComboBox>
       <TextBlock Text="2. Choose a new private-key folder" FontWeight="SemiBold" Margin="0,8,0,0"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="Folder_Click"/><TextBox x:Name="NewFolderBox" Tag="New absolute folder outside the repository/POS installation"/></DockPanel>
       <TextBlock Text="3. Choose Create encrypted key pair and set a strong passphrase when prompted." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,8"/>
       <TextBlock Text="After creation, back up the encrypted private key and its passphrase securely. Give the POS build only the matching public PEM. Keep paid lifetime and developer recovery keys separate." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
       <TextBlock Text="Trial keys are for a deployed online trial server. Trial licenses are not issued by this offline generator." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="Issuance history">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="1. Select the paid key on Generate license.  2. Return here and refresh its read-only issuance history." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,6"/><Button Content="Refresh selected key’s history" HorizontalAlignment="Left" Click="History_Click"/><TextBlock x:Name="HistoryHint" Text="The ledger contains no private key or passphrase." Style="{StaticResource SettingsHelp}"/></StackPanel>
     <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Issued (PH)" Binding="{Binding Issued}" Width="170"/>
       <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*" MinWidth="130"/>
       <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
       <DataGridTextColumn Header="Entitlement ID" Binding="{Binding EntitlementId}" Width="280"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="Developer recovery">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="#EEF0F1" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderTopThickness}" Padding="12,4">
      <DockPanel>
       <Button x:Name="RecoverBackupButton" DockPanel.Dock="Left" Content="Recover backup" HorizontalAlignment="Left" Click="RecoverBackup_Click"/>
       <Button x:Name="AuthorizeRecoveryButton" Content="Authorize password reset" HorizontalAlignment="Right" Style="{StaticResource SettingsSaveButton}" Click="AuthorizeRecovery_Click"/>
      </DockPanel>
     </Border>
     <ScrollViewer x:Name="RecoveryScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12">
       <TextBlock Text="Authorized account and backup recovery" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock Text="Use only after verifying ownership. Account reset and forgotten-backup recovery are separate workflows below." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
       <TextBlock Text="A. Authorize an account password reset" FontWeight="SemiBold"/>
       <TextBlock Text="1. Load the technician's recovery request." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="RecoveryRequest_Click"/><TextBox x:Name="RecoveryRequestPathBox" IsReadOnly="True" Tag="Exported account recovery request (.json)"/></DockPanel>
       <TextBlock Text="2. Verify the company and account"/>
       <TextBox x:Name="RecoverySummaryBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="76"/>
       <TextBlock Text="3. Select the separate developer recovery private key" FontWeight="SemiBold"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="RecoveryKey_Click"/><TextBox x:Name="RecoveryKeyPathBox" IsReadOnly="True" Tag="recovery-private.encrypted.pem"/></DockPanel>
       <TextBlock Text="4. Choose Authorize password reset, confirm the approval, save the signed response, then enter the recovery-key passphrase." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
       <Separator Margin="0,12,0,10"/>
       <TextBlock Text="B. Recover a forgotten owner backup passphrase" FontWeight="SemiBold"/>
       <TextBlock Text="1. Select a new-format encrypted backup ZIP." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Margin="8,5,0,10" Click="RecoveryBackup_Click"/><TextBox x:Name="RecoveryArchivePathBox" IsReadOnly="True" Tag="New-format encrypted ZIP backup"/></DockPanel>
       <TextBlock Text="2. Select the developer recovery private key above.  3. Choose Recover backup, save a new ZIP, unlock the recovery key, then set a replacement owner passphrase." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
       <TextBlock Text="The original ZIP is preserved. Older backups without developer recovery still require their original passphrase." Style="{StaticResource SettingsHelp}" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
