<Window x:Class="RetailForma.LicenseIssuer.Gui.PassphraseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Signing-key passphrase" Width="380" SizeToContent="Height" MaxHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{DynamicResource DialogWindow}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Styles/DialogChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="16" Background="#EEF0F1">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,5,8,5"/>
   <Button Content="Continue" IsDefault="True" MinWidth="80" Click="Continue_Click"/>
  </StackPanel>
  <ScrollViewer x:Name="PasswordScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
   <StackPanel>
    <TextBlock x:Name="HelpText" Text="Enter the private-key passphrase. It is not saved or logged." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="Passphrase"/><PasswordBox x:Name="PasswordInput" Height="{DynamicResource UiControlHeight32}" Margin="0,4,0,10"/>
    <StackPanel x:Name="ConfirmationPanel"><TextBlock Text="Confirm passphrase"/><PasswordBox x:Name="ConfirmationInput" Height="{DynamicResource UiControlHeight32}" Margin="0,4,0,0"/></StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
