<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls="clr-namespace:RetailForma.Desktop.Controls">
 <ResourceDictionary.MergedDictionaries>
  <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue"/>
  <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Thickness x:Key="UiBorderThickness">1</Thickness>
 <Thickness x:Key="UiBorderTopThickness">0,1,0,0</Thickness>
 <Thickness x:Key="UiBorderBottomThickness">0,0,0,1</Thickness>
 <Thickness x:Key="UiBorderCellThickness">0,0,1,1</Thickness>
 <sys:Double x:Key="UiBorderWidth">1</sys:Double>
 <FontFamily x:Key="UiFontFamily">/RetailForma.LicenseIssuer.Gui;component/Assets/Fonts/#Inter</FontFamily>
 <FontFamily x:Key="ReportInterFontFamily">/RetailForma.LicenseIssuer.Gui;component/Assets/Fonts/#Inter</FontFamily>
 <sys:Double x:Key="UiFontSize12">12</sys:Double>
 <sys:Double x:Key="UiFontSize14">14</sys:Double>
 <sys:Double x:Key="UiControlHeight28">28</sys:Double>
 <sys:Double x:Key="UiControlHeight32">32</sys:Double>
 <sys:Double x:Key="UiTableRowHeight28">28</sys:Double>
 <sys:Double x:Key="UiTableHeaderHeight26">26</sys:Double>
 <SolidColorBrush x:Key="UiTextBrush" Color="#1F2937"/>
 <SolidColorBrush x:Key="UiMutedBrush" Color="#475569"/>
 <SolidColorBrush x:Key="UiAccentBrush" Color="#2878BD"/>
 <SolidColorBrush x:Key="UiWarningBrush" Color="#92400E"/>
 <SolidColorBrush x:Key="UiDangerBrush" Color="#B91C1C"/>
 <Style x:Key="RetailFormaFocusVisual" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate><Grid IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control" BasedOn="{StaticResource RetailFormaFocusVisual}"/>
 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
  <Setter Property="Background" Value="#EEF0F1"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
 </Style>
 <!-- Exact approved ReportChromeButton template from the POS; shared dialog chrome is linked. -->
        <Style x:Key="ReportChromeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource ReportInterFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
            <Setter Property="Background" Value="#F7F8F9"/>
            <Setter Property="BorderBrush" Value="#CDD1D4"/>
            <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E6EFF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D8E8F3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8C969F"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F4"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D8DDE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
 <Style TargetType="Button" BasedOn="{StaticResource ReportChromeButton}"><Setter Property="Height" Value="{DynamicResource UiControlHeight28}"/><Setter Property="Margin" Value="0,5,5,5"/></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#CDD1D4"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="Padding" Value="8,0"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
  <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
  <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#CDD1D4"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="Padding" Value="8,0"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="Foreground" Value="{StaticResource UiTextBrush}"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#CDD1D4"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="2"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="controls:DataGridBehaviors.ScrollBarSpansHeader" Value="True"/>
  <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="RowHeight" Value="{DynamicResource UiTableRowHeight28}"/>
  <Setter Property="ColumnHeaderHeight" Value="{DynamicResource UiTableHeaderHeight26}"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="BorderBrush" Value="#CDD1D4"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="Background" Value="#EEF0F1"/>
  <Setter Property="Padding" Value="6,3"/>
  <Setter Property="BorderBrush" Value="#CDD1D4"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderCellThickness}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
 </Style>
 <Style TargetType="TabItem">
  <Setter Property="Padding" Value="12,5"/>
  <Setter Property="FontSize" Value="{DynamicResource UiFontSize12}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource RetailFormaFocusVisual}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Chrome" Background="#E3E7EA" BorderThickness="{StaticResource UiBorderTopThickness}" BorderBrush="Transparent">
    <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="White"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UiAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TabControl">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="#EEF0F1"/>
    <Border BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Background="White"><ContentPresenter ContentSource="SelectedContent"/></Border>
   </DockPanel>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
