<Window x:Class="RetailForma.Setup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RetailForma Technician Setup" Icon="Assets/Branding/retailforma.ico" Width="680" Height="680"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Styles/DialogChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="12" Background="#EEF0F1">
  <Border DockPanel.Dock="Top" Background="#CDD1D4" Padding="12,9" Margin="0,0,0,8">
   <DockPanel>
    <Image x:Name="RetailFormaLogo" DockPanel.Dock="Left" Source="Assets/Branding/retailforma-icon.png" Width="24" Height="24" Margin="0,0,8,0" Stretch="Uniform"/>
    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource UiMutedBrush}" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Technician Setup" FontWeight="SemiBold" FontSize="14"/>
     <TextBlock Text="Company setup, import and authorized account recovery" Foreground="{StaticResource UiMutedBrush}" Margin="0,2,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Close" Width="88" Click="Close_Click" Margin="0,5,8,5"/>
   <Button x:Name="CreateButton" Content="Create account" Width="132" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
   <Button x:Name="ResetButton" Content="Reset password" Width="132" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="Reset_Click"/>
   <Button x:Name="ImportButton" Content="Import company" Width="132" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="ImportCompany_Click"/>
  </StackPanel>
  <TabControl x:Name="ModeTabs" SelectionChanged="Mode_Changed">
   <TabItem Header="Initial setup">
  <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="FormFields" Margin="12">
    <TextBlock Text="Create the first System Administrator" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Connect to the installed RetailForma service, verify the company, then create its first administrator account." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
    <TextBlock Text="1. Protected company service" FontWeight="SemiBold"/>
    <DockPanel Margin="0,4,0,4">
     <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Connect" Margin="8,0,0,0" Width="92" Click="Browse_Click"/>
     <TextBox x:Name="DatabasePathBox" IsReadOnly="True" Height="32" Tag="Connect to the local data service"/>
    </DockPanel>
    <Border Background="#F7F8F9" BorderBrush="#CDD1D4" BorderThickness="{StaticResource UiBorderThickness}" Padding="9,7" Margin="0,0,0,12">
     <TextBlock x:Name="DatabaseStatusText" Text="Install RetailForma first. Connect checks the protected data service; it does not create a company." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
    </Border>
    <TextBlock Text="2. Enter company and administrator details" FontWeight="SemiBold" Margin="0,0,0,5"/>
    <StackPanel x:Name="NewCompanyPanel" Visibility="Collapsed">
     <TextBlock Text="Company name"/><TextBox x:Name="CompanyBox" Height="32" Margin="0,4,0,10" Tag="Enter the business name shown in RetailForma"/>
    </StackPanel>
    <TextBlock Text="Administrator username"/><TextBox x:Name="UsernameBox" Height="32" Margin="0,4,0,10" Tag="Choose an individual username"/>
    <TextBlock Text="Administrator full name"/><TextBox x:Name="FullNameBox" Height="32" Margin="0,4,0,10" Tag="Enter the person's name"/>
    <TextBlock Text="Password (16–256 characters)"/><PasswordBox x:Name="PasswordBox" Height="32" Margin="0,4,0,10"/>
    <TextBlock Text="Confirm password"/><PasswordBox x:Name="ConfirmPasswordBox" Height="32" Margin="0,4,0,12"/>
    <TextBlock Text="Use a unique, strong password and store it securely. It is not your license-key or backup passphrase." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,8"/>
    <TextBlock Text="3. Verify before creating" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <CheckBox x:Name="TargetConfirmedBox" Content="I verified the intended company and installation." Margin="0,4,0,10"/>
    <TextBlock Text="This creates only the first System Administrator. It does not create an Owner or Cashier; add those accounts after signing in to RetailForma." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
   </StackPanel>
  </ScrollViewer>
   </TabItem>
   <TabItem Header="Account recovery">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="RecoveryFields" Margin="12">
      <TextBlock Text="Recover administrator access" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Use only when the company already exists and its System Administrator account is inaccessible. A programmer must sign the one-time request." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="1. Enter the affected account username"/><TextBox x:Name="RecoveryUsernameBox" Height="32" Margin="0,4,0,8"/>
      <Button Content="2. Export recovery request" HorizontalAlignment="Left" Click="ExportRecovery_Click" Margin="0,5,0,8"/>
      <TextBlock Text="3. Give the request to the programmer. They verify ownership and sign it in License Generator. The authorization expires in five minutes and works once." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="4. Select the signed authorization"/>
      <DockPanel Margin="0,4,0,10">
       <Button Content="Browse" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Click="BrowseAuthorization_Click"/>
       <TextBox x:Name="AuthorizationPathBox" Height="32" IsReadOnly="True"/>
      </DockPanel>
      <TextBlock Text="5. Enter a temporary password (16–256 characters)"/><PasswordBox x:Name="RecoveryPasswordBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="6. Confirm the temporary password"/><PasswordBox x:Name="RecoveryConfirmBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="The service verifies a safety snapshot before resetting the password. Roles remain unchanged. The user must change the temporary password at next sign-in." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Import company">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="12">
      <TextBlock Text="Import an existing company" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Use this when moving an existing RetailForma company. For a brand-new company, use Initial setup instead." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="1. Select the existing company backup (.zip or supported legacy .db)"/>
      <DockPanel Margin="0,4,0,12">
       <Button Content="Browse" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Click="BrowseImport_Click"/>
       <TextBox x:Name="ImportPathBox" IsReadOnly="True" Height="32"/>
      </DockPanel>
      <TextBlock Text="2. Enter the backup passphrase" TextWrapping="Wrap"/><PasswordBox x:Name="ImportPasswordBox" Height="32" Margin="0,4,0,4"/>
      <TextBlock Text="For an encrypted ZIP, enter its existing passphrase. For a legacy .db file, choose a new recovery passphrase for the encrypted migration backup." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="Close the old POS and create a verified encrypted backup first. Import keeps the original archive and accounts, validates conversion, and creates an encrypted safety copy before publishing protected company storage." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,12"/>
      <CheckBox x:Name="ImportConfirmedBox" Margin="0,4,0,12"><TextBlock Text="3. The old POS is closed, and I kept an independent copy of the original database and backup." TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="4. Choose Import company, review the verified company/account/sales preview, then confirm to complete the import." TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,10"/>
      <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
