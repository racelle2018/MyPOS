<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>1.2.3</Version>
    <Company>RetailForma Ltd.</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../RetailForma.Desktop/Assets/Branding/retailforma.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>RetailForma Technician Setup</Title>
    <AssemblyTitle>RetailForma Technician Setup</AssemblyTitle>
    <Description>RetailForma initial System Administrator provisioning tool</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RetailForma.Core/RetailForma.Core.csproj" />
    <ProjectReference Include="../RetailForma.LocalTransport/RetailForma.LocalTransport.csproj" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <Page Include="../RetailForma.LicenseIssuer.Gui/Styles/IssuerTheme.xaml" Link="Styles/TechnicianTheme.xaml" />
    <Page Include="../RetailForma.Desktop/Styles/DialogChrome.xaml" Link="Styles/DialogChrome.xaml" />
    <Page Include="../RetailForma.Desktop/Dialogs/NotificationDialog.xaml" Link="Dialogs/NotificationDialog.xaml" />
    <Compile Include="../RetailForma.Desktop/Dialogs/NotificationDialog.xaml.cs" Link="Dialogs/NotificationDialog.xaml.cs" />
    <Compile Include="../RetailForma.Desktop/Dialogs/ActionDialog.cs" Link="Dialogs/ActionDialog.cs" />
    <Compile Include="../RetailForma.Desktop/Controls/DataGridBehaviors.cs" Link="Controls/DataGridBehaviors.cs" />
    <Resource Include="../RetailForma.Desktop/Assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <Resource Include="../RetailForma.Desktop/Assets/Branding/*.png" Link="Assets/Branding/%(Filename)%(Extension)" />
    <Resource Include="../RetailForma.Desktop/Assets/Branding/*.ico" Link="Assets/Branding/%(Filename)%(Extension)" />
    <None Include="../RetailForma.Desktop/Assets/Fonts/INTER-LICENSE.txt" Link="Assets/Fonts/INTER-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../RetailForma.Desktop/Assets/Fonts/OFL.txt" Link="Assets/Fonts/OFL.txt" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>RetailForma.Setup.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
