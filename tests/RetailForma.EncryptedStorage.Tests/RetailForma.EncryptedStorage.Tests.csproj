<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SqlCipherNativeDirectory Condition="'$(SqlCipherNativeDirectory)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native-security/output</SqlCipherNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../src/RetailForma.EncryptedStorage/RetailForma.EncryptedStorage.csproj" />
    <ProjectReference Include="../../src/RetailForma.Application/RetailForma.Application.csproj" />
    <ProjectReference Include="../../src/RetailForma.DataService/RetailForma.DataService.csproj" />
    <Using Include="Xunit" />
    <None Include="$(SqlCipherNativeDirectory)/sqlcipher.dll" Link="sqlcipher.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SqlCipherNativeDirectory)/sqlcipher.dll')" />
  </ItemGroup>
</Project>
